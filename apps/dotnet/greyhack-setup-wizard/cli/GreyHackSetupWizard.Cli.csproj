<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AssemblyName>greyhack-setup-wizard</AssemblyName>
    <RootNamespace>GreyHackSetupWizard.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GreybelDotnet)greyhack-setup-wizard/src/GreyHackSetupWizard.csproj" />
  </ItemGroup>

  <!-- The texts it shows, as a class generated from the .resx at build (English, the neutral language). -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/CommandText.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)CommandText.g.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>GreyHackSetupWizard.Cli.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CommandText</StronglyTypedClassName>
      <PublicClass>false</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
