<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="using:GreyHackSetupWizard.Gui.Converters"
  x:Class="GreyHackSetupWizard.Gui.App"
  RequestedThemeVariant="Default"
>
  <Application.Resources>
    <converters:EnumMatchConverter x:Key="EnumMatch" />
    <FontFamily x:Key="MonospaceFont">Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="#D13438" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>
</Application>
