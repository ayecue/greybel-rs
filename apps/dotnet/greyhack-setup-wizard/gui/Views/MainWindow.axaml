<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:GreyHackSetupWizard.Gui.ViewModels"
  xmlns:res="using:GreyHackSetupWizard.Gui.Resources"
  xmlns:views="using:GreyHackSetupWizard.Gui.Views"
  x:Class="GreyHackSetupWizard.Gui.Views.MainWindow"
  x:DataType="vm:MainViewModel"
  Title="{x:Static res:WindowText.WindowTitle}"
  Width="820"
  Height="560"
  MinWidth="640"
  MinHeight="460"
  WindowStartupLocation="CenterScreen"
>
  <Panel>
    <!-- The status page. -->
    <Grid RowDefinitions="*,Auto" IsVisible="{Binding !IsWizardOpen}">
      <ScrollViewer Padding="32,28,32,12">
        <views:StatusView DataContext="{Binding Game}" />
      </ScrollViewer>
      <Border
        Grid.Row="1"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,1,0,0"
        Padding="32,12"
      >
        <Button
          Name="startSetup"
          Content="{Binding SetupText}"
          Classes="accent"
          HorizontalAlignment="Right"
          Command="{Binding StartSetupCommand}"
        />
      </Border>
    </Grid>

    <!-- The wizard, while it is open. -->
    <ContentControl Content="{Binding Wizard}" IsVisible="{Binding IsWizardOpen}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:WizardViewModel">
          <views:WizardView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</Window>
