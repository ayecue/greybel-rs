<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:GreyHackSetupWizard.Gui.ViewModels"
  xmlns:res="using:GreyHackSetupWizard.Gui.Resources"
  x:Class="GreyHackSetupWizard.Gui.Views.StatusView"
  x:DataType="vm:GameStatusViewModel"
>
  <StackPanel Spacing="16">
    <TextBlock Classes="heading" Text="{x:Static res:WindowText.StatusHeading}" />
    <TextBlock Classes="note" Text="{x:Static res:WindowText.StatusIntro}" />

    <Border Name="readiness" CornerRadius="4" Padding="14,10" Classes.ready="{Binding IsReady}">
      <TextBlock Text="{Binding ReadinessText}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>

    <Grid
      ColumnDefinitions="Auto,*"
      RowDefinitions="Auto,Auto,Auto,Auto"
      RowSpacing="8"
      ColumnSpacing="16"
    >
      <TextBlock Text="{x:Static res:WindowText.StatusFolderLabel}" Opacity="0.7" />
      <SelectableTextBlock
        Grid.Column="1"
        Name="folder"
        Text="{Binding FolderText}"
        TextWrapping="Wrap"
      />
      <TextBlock Grid.Row="1" Text="{x:Static res:WindowText.StatusBepInExLabel}" Opacity="0.7" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BepInExText}" />
      <TextBlock Grid.Row="2" Text="{x:Static res:WindowText.StatusPluginLabel}" Opacity="0.7" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PluginText}" />
      <TextBlock Grid.Row="3" Text="{x:Static res:WindowText.StatusPortLabel}" Opacity="0.7" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PortText}" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button
        Content="{x:Static res:WindowText.ChooseFolder}"
        Command="{Binding ChooseFolderCommand}"
      />
      <Button Content="{x:Static res:WindowText.SearchAgain}" Command="{Binding LocateCommand}" />
    </StackPanel>

    <TextBlock
      Name="error"
      Classes="problem"
      Text="{Binding Error}"
      IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
    />
  </StackPanel>

  <UserControl.Styles>
    <Style Selector="Border#readiness">
      <Setter Property="Background" Value="#33D13438" />
    </Style>
    <Style Selector="Border#readiness.ready">
      <Setter Property="Background" Value="#3310893E" />
    </Style>
  </UserControl.Styles>
</UserControl>
