<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:GreyHackSetupWizard.Gui.ViewModels"
  xmlns:res="using:GreyHackSetupWizard.Gui.Resources"
  x:Class="GreyHackSetupWizard.Gui.Views.PortPageView"
  x:DataType="vm:PortPageViewModel"
>
  <StackPanel Spacing="16">
    <TextBlock Classes="heading" Text="{x:Static res:WindowText.PortPageTitle}" />
    <TextBlock Classes="note" Text="{Binding CurrentText}" />

    <StackPanel Spacing="4">
      <RadioButton
        GroupName="portAction"
        Content="{x:Static res:WindowText.PortSet}"
        IsChecked="{Binding Action, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:SetupAction.Install}}"
      />
      <RadioButton
        GroupName="portAction"
        Content="{x:Static res:WindowText.NothingToChange}"
        IsChecked="{Binding Action, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static vm:SetupAction.Skip}}"
      />
    </StackPanel>

    <NumericUpDown
      Name="port"
      Value="{Binding Port}"
      IsVisible="{Binding IsPortSetup}"
      Minimum="1"
      Maximum="65535"
      Increment="1"
      FormatString="0"
      Width="160"
      HorizontalAlignment="Left"
      Margin="24,0,0,0"
    />

    <TextBlock
      Name="portWarning"
      Classes="problem"
      Text="{Binding PortWarning}"
      IsVisible="{Binding PortWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
    />
  </StackPanel>
</UserControl>
