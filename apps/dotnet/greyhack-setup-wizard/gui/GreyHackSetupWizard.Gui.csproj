<Project Sdk="Microsoft.NET.Sdk">
  <!-- The setup wizard's window: the same steps as the command-line tool (src/Setup), one page each. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AssemblyName>greyhack-setup-wizard-gui</AssemblyName>
    <RootNamespace>GreyHackSetupWizard.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GreybelDotnet)greyhack-setup-wizard/src/GreyHackSetupWizard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GreyHackSetupWizard.Gui.Tests" />
  </ItemGroup>

  <!-- The texts it shows, as a class generated from the .resx at build (English, the neutral language). -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/WindowText.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)WindowText.g.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>GreyHackSetupWizard.Gui.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>WindowText</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
