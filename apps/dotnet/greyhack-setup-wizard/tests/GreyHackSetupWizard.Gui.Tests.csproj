<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GreybelDotnet)greyhack-setup-wizard/src/GreyHackSetupWizard.csproj" />
    <ProjectReference Include="../gui/GreyHackSetupWizard.Gui.csproj" />
  </ItemGroup>

  <!-- The library's fakes of a game, its folders and GitHub, which the window's tests drive it with. -->
  <ItemGroup>
    <Compile
      Include="$(GreybelDotnet)greyhack-setup-wizard/tests/Support/FakeGame.cs"
      Link="Support/FakeGame.cs"
    />
    <Compile
      Include="$(GreybelDotnet)greyhack-setup-wizard/tests/Support/FakeGitHub.cs"
      Link="Support/FakeGitHub.cs"
    />
    <Compile
      Include="$(GreybelDotnet)greyhack-setup-wizard/tests/Support/TemporaryFolder.cs"
      Link="Support/TemporaryFolder.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
