<Project>
  <!-- Folders outside a project that it reads or writes. A project embeds one
       with <AssemblyMetadata Include="AssetsRust" Value="$(AssetsRust)" />. -->
  <PropertyGroup>
    <AssetsDotnet>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</AssetsDotnet>
    <AssetsRust>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../rs'))</AssetsRust>
  </PropertyGroup>
</Project>
