{
  "name": "presets",
  "version": "0.1.0",
  "description": "What the repository's TypeScript workspaces share: the base tsconfig, the Prettier and ESLint configurations `pnpm format` lays code out with, and the Vitest configuration",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./prettier": "./prettier.json",
