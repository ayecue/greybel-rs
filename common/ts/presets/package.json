    "./vitest": "./src/vitest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "eslint": "^10.14.0"
  }
}
