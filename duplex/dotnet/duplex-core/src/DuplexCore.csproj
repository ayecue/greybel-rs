<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 so that Unity's Mono loads it; projects for Unity compile its sources into themselves
       (see README.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Duplex</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DuplexCore.Tests" />
  </ItemGroup>
</Project>
