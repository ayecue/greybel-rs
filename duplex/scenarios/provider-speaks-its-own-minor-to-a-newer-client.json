{
  "$schema": "../schema/scenario.schema.json",
  "description": "A provider acknowledges a client of a newer minor with its own, whose fingerprint the client checks.",
  "peer": "provider",
  "requires": [],
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Listen": {}
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Open": {
              "id": 0,
              "protocol": "1.9",
              "fingerprint": 7
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Ack": {
                  "id": 0,
                  "connection": 1
                }
              }
            ]
          }
        ],
        "connection": 1,
        "version": "1.1",
        "deprecated": []
      }
    }
  ]
}
