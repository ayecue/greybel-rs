{
  "$schema": "../schema/scenario.schema.json",
  "description": "A closing provider tells its client why.",
  "peer": "provider",
  "requires": [],
  "connected": true,
  "steps": [
    {
      "close": "Panic"
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Close": {
                  "reason": "Panic"
                }
              }
            ]
          }
        ],
        "closed": "Panic"
      }
    }
  ]
}
