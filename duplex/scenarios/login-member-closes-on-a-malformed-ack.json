{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client closes a connection whose acknowledgement it can't read as malformed, telling the provider.",
  "peer": "client",
  "requires": ["handshake"],
  "open": {
    "user": "ada",
    "token": "t0k"
  },
  "protocol": "login",
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Open": {
                  "id": 0,
                  "payload": {
                    "user": "ada",
                    "token": "t0k"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Ack": {
              "id": 0,
              "connection": 1
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Close": {
                  "reason": "MalformedMessage"
                }
              }
            ]
          }
        ],
        "connection": null,
        "closed": "MalformedMessage"
      }
    }
  ]
}
