{
  "$schema": "../schema/scenario.schema.json",
  "description": "A check right after anything of the client counts no miss and sends no ping; the check after it pings again.",
  "peer": "provider",
  "requires": ["health-check"],
  "connected": true,
  "healthCheck": true,
  "steps": [
    {
      "receive": {
        "connection": 1,
        "frames": [
          {
            "Ping": {}
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Pong": {}
              }
            ]
          }
        ]
      }
    },
    {
      "check": 1
    },
    {
      "expect": {
        "sent": []
      }
    },
    {
      "check": 1
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Ping": {}
              }
            ]
          }
        ]
      }
    }
  ]
}
