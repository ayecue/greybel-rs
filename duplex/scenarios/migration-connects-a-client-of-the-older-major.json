{
  "$schema": "../schema/scenario.schema.json",
  "description": "A provider of the calculator's 2.x serves a client of 1.x by a migration: it acknowledges the client's version.",
  "peer": "provider",
  "requires": ["migration"],
  "major": 2,
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Listen": {}
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Open": {
              "id": 0
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Ack": {
                  "id": 0,
                  "connection": 1,
                  "protocol": "1.1"
                }
              }
            ]
          }
        ],
        "connection": 1,
        "version": "1.1"
      }
    }
  ]
}
