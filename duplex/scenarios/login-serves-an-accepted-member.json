{
  "$schema": "../schema/scenario.schema.json",
  "description": "A provider serves a client it accepted.",
  "peer": "provider",
  "requires": ["responses", "handshake"],
  "connected": true,
  "protocol": "login",
  "steps": [
    {
      "receive": {
        "connection": 1,
        "frames": [
          {
            "Message": {
              "id": 0,
              "Whoami": {}
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "ResponseEnd": {
                  "id": 0,
                  "Whoami": "ada"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
