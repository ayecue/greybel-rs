{
  "$schema": "../schema/scenario.schema.json",
  "description": "A provider refuses a client built from another definition.",
  "peer": "provider",
  "requires": [],
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Listen": {}
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Open": {
              "id": 7,
              "fingerprint": 1
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Refuse": {
                  "id": 7,
                  "reason": "VersionMismatch"
                }
              }
            ]
          }
        ],
        "connection": null
      }
    }
  ]
}
