{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client fails a message a field of which doesn't meet its requirement, sending nothing.",
  "peer": "client",
  "requires": ["responses"],
  "connected": true,
  "steps": [
    {
      "send": {
        "Divide": {
          "dividend": 6,
          "divisor": 3,
          "precision": 13
        }
      },
      "as": "quotient"
    },
    {
      "expect": {
        "sent": [],
        "settled": {
          "quotient": {
            "invalid": {
              "path": [
                2
              ],
              "requirement": "Maximum"
            }
          }
        }
      }
    }
  ]
}
