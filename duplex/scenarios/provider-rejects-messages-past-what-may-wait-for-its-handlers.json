{
  "$schema": "../schema/scenario.schema.json",
  "description": "A provider rejects a message as overloaded as it comes once as many as its limits allow wait for a handler, and handles those that wait.",
  "peer": "provider",
  "requires": ["responses", "limits"],
  "connected": true,
  "limits": {
    "waiting": 1
  },
  "steps": [
    {
      "receive": {
        "connection": 1,
        "frames": [
          {
            "Message": {
              "id": 0,
              "Add": {
                "a": 1,
                "b": 2
              }
            }
          },
          {
            "Message": {
              "id": 1,
              "Add": {
                "a": 3,
                "b": 4
              }
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Failure": {
                  "id": 1,
                  "rejected": "Overload"
                }
              },
              {
                "ResponseEnd": {
                  "id": 0,
                  "Add": 3
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
