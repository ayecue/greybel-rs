{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client opens with what the protocol's handshake declares, and keeps what the provider acknowledges it with.",
  "peer": "client",
  "requires": ["responses", "handshake"],
  "open": {
    "user": "ada",
    "token": "t0k"
  },
  "protocol": "login",
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Open": {
                  "id": 0,
                  "payload": {
                    "user": "ada",
                    "token": "t0k"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Ack": {
              "id": 0,
              "connection": 1,
              "payload": {
                "greeting": "hello, ada"
              }
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [],
        "connection": 1,
        "ack": {
          "greeting": "hello, ada"
        }
      }
    },
    {
      "send": {
        "Whoami": {}
      },
      "as": "whoami"
    },
    {
      "receive": {
        "connection": 1,
        "frames": [
          {
            "ResponseEnd": {
              "id": 0,
              "Whoami": "ada"
            }
          }
        ]
      }
    },
    {
      "expect": {
        "settled": {
          "whoami": {
            "response": "ada"
          }
        }
      }
    }
  ]
}
