{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client writes what it queued before the acknowledgement for the minor acknowledged, and drops a notification newer than it.",
  "peer": "client",
  "requires": ["responses"],
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Open": {
                  "id": 0
                }
              }
            ]
          }
        ]
      }
    },
    {
      "send": {
        "Divide": {
          "dividend": 7,
          "divisor": 2,
          "precision": 3
        }
      },
      "as": "divided"
    },
    {
      "send": {
        "Reset": {}
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Ack": {
              "id": 0,
              "connection": 1,
              "protocol": "1.0"
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "minor": 0,
            "frames": [
              {
                "Message": {
                  "id": 0,
                  "Divide": {
                    "dividend": 7,
                    "divisor": 2
                  }
                }
              }
            ]
          }
        ],
        "settled": {
          "divided": "pending"
        }
      }
    }
  ]
}
