{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client fails its messages with the declared failure or the reason the provider rejected them.",
  "peer": "client",
  "requires": ["responses"],
  "connected": true,
  "steps": [
    {
      "send": {
        "Add": {
          "a": 1,
          "b": 2
        }
      },
      "as": "sum"
    },
    {
      "send": {
        "Divide": {
          "dividend": 1,
          "divisor": 0
        }
      },
      "as": "quotient"
    },
    {
      "expect": {
        "sent": [
          {
            "connection": 1,
            "frames": [
              {
                "Message": {
                  "id": 0,
                  "Add": {
                    "a": 1,
                    "b": 2
                  }
                }
              },
              {
                "Message": {
                  "id": 1,
                  "Divide": {
                    "dividend": 1,
                    "divisor": 0
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 1,
        "frames": [
          {
            "Failure": {
              "id": 0,
              "rejected": "UnhandledMessage"
            }
          },
          {
            "Failure": {
              "id": 1,
              "Divide": "ByZero"
            }
          }
        ]
      }
    },
    {
      "expect": {
        "settled": {
          "sum": {
            "rejected": "UnhandledMessage"
          },
          "quotient": {
            "failed": "ByZero"
          }
        }
      }
    }
  ]
}
