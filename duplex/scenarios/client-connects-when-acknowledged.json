{
  "$schema": "../schema/scenario.schema.json",
  "description": "A client takes the connection the provider acknowledges.",
  "peer": "client",
  "requires": [],
  "steps": [
    {
      "expect": {
        "sent": [
          {
            "connection": 0,
            "frames": [
              {
                "Open": {
                  "id": 0
                }
              }
            ]
          }
        ]
      }
    },
    {
      "receive": {
        "connection": 0,
        "frames": [
          {
            "Ack": {
              "id": 0,
              "connection": 1
            }
          }
        ]
      }
    },
    {
      "expect": {
        "sent": [],
        "connection": 1
      }
    }
  ]
}
