{
  "name": "duplex-driver-http",
  "version": "0.1.0",
  "description": "Channels of duplex protocols as the client of an HTTP server: batches up in POSTs, down in long-polled GETs, a stream of server-sent events or a streamed binary body, in browsers and on Node",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "duplex-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.21.0",
    "playwright": "1.64.1"
  }
}
