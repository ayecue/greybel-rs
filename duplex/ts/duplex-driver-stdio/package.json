{
  "name": "duplex-driver-stdio",
  "version": "0.1.0",
  "description": "Channels of duplex protocols over a byte stream on Node: standard input and output, or a child process, with their batches delimited by their lengths",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "duplex-core": "workspace:*"
  }
}
