use core 1.0;
deprecated "1.1 tells how long a calculation takes";

/// Calculator client for a user.
protocol Calculation = "calculator" {
    provider Calculator {
        /// Entry for the calculator log.
        message Log {
            text: string,
        } limit 4MiB
        message Add {
            a: i64,
            b: i64,
        } -> i64
        message Divide {
            dividend: i64,
            divisor: i64,
        } -> Result<Quotient, DivisionFailure>
    }

    /// Client that requests calculator operations.
    client User {
        /// Calculator asks for confirmation before a long calculation.
        message Confirm {
            question: string,
        } -> bool
        /// Progress of a long calculation.
        message Progress {
            phase: Phase,
            /// Completed fraction, when known.
            done_share: f64?,
            steps: list<Step>,
            counts: record<u32>,
            note?: string?,
        }
    }
}

union Quotient {
    Exact { value: i64 },
    WithRemainder { value: i64, remainder: i64 },
}

/// Reason a division was not completed.
enum DivisionFailure {
    ByZero,
    /// User declined the confirmation request.
    Refusal,
}

enum Phase {
    Pending,
    Active,
}

/// Completed calculation step.
struct Step {
    name: string(1..=32, match "[a-z ]+"),
    result: Quotient?,
}
