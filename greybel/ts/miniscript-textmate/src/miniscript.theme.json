    "activityBar.activeBackground": "#be84ba13",
    "activityBar.activeFocusBorder": "#be84ba",
    "sideBar.background": "#181818",
    "sideBarSectionHeader.background": "#252525",
    "minimap.selectionHighlight": "#be84ba80",
    "minimap.errorHighlight": "#F07171",
    "minimap.warningHighlight": "#FA8D3E",
    "minimapGutter.addedBackground": "#78BD65",
    "minimapGutter.deletedBackground": "#F07171",
    "minimapGutter.modifiedBackground": "#399EE6",
    "editorGroup.border": "#111111",
    "editorGroup.dropBackground": "#be84ba30",
    "editorGroupHeader.noTabsBackground": "#2b2b2b",
    "editorGroupHeader.tabsBackground": "#2b2b2b",
    "tab.activeBackground": "#1e1e1e",
    "tab.border": "#383838",
    "tab.activeBorder": "#be84ba",
    "tab.lastPinnedBorder": "#be84ba50",
    "tab.inactiveBackground": "#2b2b2b",
    "tab.hoverBackground": "#383838",
    "tab.activeModifiedBorder": "#399EE6",
    "editorPane.background": "#141414",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#E6E6E6",
    "editorLineNumber.foreground": "#515151",
    "editorLineNumber.activeForeground": "#9e9e9e",
    "editorCursor.background": "#000000",
    "editorCursor.foreground": "#be84ba",
    "editor.selectionBackground": "#be84ba30",
    "editor.findMatchHighlightBackground": "#E6E6E630",
    "editor.findMatchBorder": "#be84ba",
    "editor.lineHighlightBackground": "#2b2b2b",
    "editorLink.activeForeground": "#be84ba",
    "editorWhitespace.foreground": "#515151",
    "editorIndentGuide.background": "#383838",
    "editorIndentGuide.activeBackground": "#be84ba",
    "editorRuler.foreground": "#383838",
    "editorBracketMatch.border": "#8b6188",
    "editorBracketMatch.background": "#191919",
    "editor.foldBackground": "#dcdcaa30",
    "editorOverviewRuler.border": "#383838",
    "editorOverviewRuler.selectionHighlightForeground": "#be84ba",
    "editorOverviewRuler.modifiedForeground": "#399EE6",
    "editorOverviewRuler.addedForeground": "#399EE6",
    "editorOverviewRuler.deletedForeground": "#399EE6",
    "editorOverviewRuler.errorForeground": "#F07171",
    "editorOverviewRuler.warningForeground": "#FA8D3E",
    "editorOverviewRuler.infoForeground": "#399EE6",
    "editorOverviewRuler.bracketMatchForeground": "#be84ba",
    "editorError.foreground": "#F07171",
    "editorWarning.foreground": "#FA8D3E",
    "editorInfo.foreground": "#399EE6",
    "problemsErrorIcon.foreground": "#F07171",
    "problemsWarningIcon.foreground": "#FA8D3E",
    "problemsInfoIcon.foreground": "#399EE6",
    "editorGutter.modifiedBackground": "#399EE6",
    "editorGutter.addedBackground": "#78BD65",
    "editorGutter.deletedBackground": "#F07171",
    "diffEditor.insertedTextBackground": "#78BD6530",
    "diffEditor.removedTextBackground": "#F0717135",
    "editorWidget.background": "#1e1e1e",
    "editorWidget.resizeBorder": "#383838",
    "editorSuggestWidget.background": "#2b2b2b",
    "editorSuggestWidget.border": "#383838",
    "editorSuggestWidget.highlightForeground": "#be84ba",
    "editorHoverWidget.border": "#383838",
    "editorMarkerNavigation.background": "#1e1e1e",
    "editorMarkerNavigationError.background": "#F07171",
    "editorMarkerNavigationWarning.background": "#FA8D3E",
    "editorMarkerNavigationInfo.background": "#399EE6",
    "peekViewResult.background": "#2b2b2b",
    "peekViewTitle.background": "#111111",
    "panel.dropBorder": "#be84ba",
    "panelTitle.activeBorder": "#be84ba",
    "statusBar.background": "#111111",
    "statusBarItem.hoverBackground": "#2b2b2b",
    "statusBarItem.prominentBackground": "#be84ba",
    "statusBarItem.prominentForeground": "#000000",
    "statusBarItem.prominentHoverBackground": "#a572a1",
    "titleBar.activeBackground": "#2b2b2b",
    "titleBar.inactiveBackground": "#1e1e1e",
    "titleBar.border": "#303030",
    "menu.background": "#1e1e1e",
    "menu.foreground": "#E6E6E6",
    "menu.selectionBackground": "#be84baDD",
    "menu.selectionForeground": "#000000",
    "menu.separatorBackground": "#515151",
