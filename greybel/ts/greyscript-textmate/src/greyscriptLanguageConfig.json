{
  "comments": {
    "blockComment": [
      "/*",
      "*/"
    ],
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*end\\b)\\s*(?:(?:while|for)\\b.*|if\\b.*\\bthen|else(?:\\s+if\\b.*\\bthen)?|.*\\bfunction\\s*(?:\\([^)]*\\))?)\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*(?:else\\b|end\\s+(?:if|function|for|while)\\b)"
  }
}