{
    "version": "2.0.0",
    "name": "GreyScript",
    "scopeName": "source.src",
    "patterns": [
        {
            "include": "#template"
        },
        {
            "include": "#string"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#constant"
        },
        {
            "include": "#typed-code"
        },
        {
            "include": "#class"
        },
        {
            "include": "#short-function-parameters"
        },
        {
            "include": "#function"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#type"
        },
        {
            "include": "#general-functions"
        },
        {
            "include": "#type-methods"
        },
        {
            "patterns": [
                {
                    "include": "#variables"
                },
                {
                    "include": "#identifier"
                }
            ]
        }
    ],
    "repository": {
        "function": {
            "begin": "(?<=\\bfunction)(?:(<)([A-Za-z_][A-Za-z0-9_, ]*)(>))?(\\()",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.typeparameters.begin.greyscript"
                },
                "2": {
                    "name": "entity.name.type.greyscript"
                },
                "3": {
                    "name": "punctuation.definition.typeparameters.end.greyscript"
                }
            },
            "end": "(\\))(?:[ \\t]*(:)[ \\t]*(.+?)[ \\t]*(?=$|//))?",
            "endCaptures": {
                "2": {
                    "name": "keyword.operator.type.annotation.greyscript"
                },
                "3": {
                    "patterns": [
                        {
                            "include": "#type-annotation"
                        }
                    ]
                }
            },
            "patterns": [
                {
                    "include": "#parameter"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "support.variable.greyscript",
                    "match": "\\b(params|locals|globals|outer)\\b"
                },
                {
                    "name": "variable.language.self.greyscript",
                    "match": "\\b(self)\\b"
                },
                {
                    "name": "variable.language.super.greyscript",
                    "match": "\\b(super)\\b"
                }
            ]
        },
        "identifier": {
            "patterns": [
                {
                    "name": "entity.other.attribute.greyscript",
                    "match": "(?<=[^.]\\.)\\b([a-zA-Z_][\\w]*)"
                },
                {
                    "name": "constant.other.greyscript",
                    "match": "\\b([A-Z_]+)\\b"
                },
                {
                    "name": "entity.name.type.greyscript",
                    "match": "\\b([A-Z][\\w]*)\\b"
                },
                {
                    "name": "variable.other.greyscript",
                    "match": "\\b([a-z_][\\w]*)\\b"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "name": "comment.line",
                    "begin": "//(?!(include|import))",
                    "end": "\\n"
                },
                {
                    "name": "comment.block",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "name": "constant.numeric",
                    "match": "(?<![\\w\\d.])(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\\d[\\d_]*(\\.[\\d_]+)?([eE][-+]?[\\d_]*)?)"
                }
            ]
        },
        "template": {
            "name": "string.interpolated.greyscript",
            "begin": "#\"",
            "end": "\"(?!\")",
            "patterns": [
                {
                    "name": "constant.character.escape.greyscript",
                    "match": "\"\"|\\{\\{|\\}\\}"
                },
                {
                    "name": "meta.embedded.expression.greyscript",
                    "begin": "\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.begin.greyscript"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.end.greyscript"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "string": {
            "name": "string.quoted.double.greyscript",
            "begin": "\"",
            "end": "\""
        },
        "keyword": {
            "patterns": [
                {
                    "name": "keyword.control.as.greybel.greyscript",
                    "match": "(?<=[\\w\\]\\)][ \\t])as(?=[ \\t]+[A-Za-z_])"
                },
                {
                    "name": "keyword.control.block.greybel.greyscript",
                    "match": "\\bend class\\b"
                },
                {
                    "name": "storage.modifier.greybel.greyscript",
                    "match": "^\\s*(private|static)(?=[ \\t]+[A-Za-z_])|(?<=^\\s*(?:private|static)[ \\t])(private|static)(?=[ \\t]+[A-Za-z_])"
                },
                {
                    "match": "^\\s*(case)[ \\t]+(is)(?=[ \\t]+[A-Za-z_])",
                    "captures": {
                        "1": {
                            "name": "keyword.control.block.greybel.greyscript"
                        },
                        "2": {
                            "name": "keyword.operator.type.greyscript"
                        }
                    }
                },
                {
                    "name": "keyword.control.block.greybel.greyscript",
                    "match": "^\\s*(switch|case)(?=[ \\t]+[^\\s=.\\[;])|\\bend switch\\b"
                },
                {
                    "name": "storage.type.function.arrow.greybel.greyscript",
                    "match": "=>"
                },
                {
                    "name": "keyword.control.statement.greybel.greyscript",
                    "match": "^\\s*(assert)(?=[ \\t]+[^\\s=.\\[;])"
                },
                {
                    "name": "keyword.control.block.greybel.greyscript",
                    "match": "^\\s*(enum)(?=[ \\t]+[A-Za-z_])|(?<=\\bconst )enum(?=[ \\t]+[A-Za-z_])|\\bend enum\\b"
                },
                {
                    "name": "keyword.control.block.greyscript",
                    "match": "\\b(if|then|end|else|function|in|while|for|from)\\b"
                },
                {
                    "name": "keyword.control.statement.greyscript",
                    "match": "\\b(return|continue|break)\\b"
                },
                {
                    "name": "keyword.control.logical.greyscript",
                    "match": "\\b(and|or|isa)\\b"
                },
                {
                    "name": "keyword.control.unary.greyscript",
                    "match": "\\b(not|new)\\b"
                },
                {
                    "name": "keyword.control.notused.greyscript",
                    "match": "\\b(repeat)\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "#(include|import|envar|filename|line|inject)\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "#include\\s+type\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "#(if|else|endif)\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "//(include|import)\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "//include\\s+type\\b"
                },
                {
                    "name": "keyword.control.greybel.greyscript",
                    "match": "\\b(debugger)\\b"
                },
                {
                    "name": "storage.modifier.greybel.greyscript",
                    "match": "^\\s*(let|const|export)(?=[ \\t]+[A-Za-z_\\[{])"
                },
                {
                    "name": "keyword.operator.optional.greybel.greyscript",
                    "match": "\\?\\.(?!\\d)|\\?\\?"
                },
                {
                    "name": "keyword.operator.ternary.greybel.greyscript",
                    "match": "\\?"
                },
                {
                    "name": "keyword.operator.spread.greybel.greyscript",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.non-null.greybel.greyscript",
                    "match": "(?<=[\\w\\)\\]])!(?!=)"
                },
                {
                    "name": "keyword.operator.greyscript",
                    "match": "([<>=!]=|[+\\-*\\/^<>|\\&%]|<<|>>>?)"
                }
            ]
        },
        "constant": {
            "name": "constant.language.greyscript",
            "match": "\\b(true|false|null)\\b"
        },
        "type": {
            "name": "support.class.greyscript",
            "match": "\\b(list|map|number|string|funcRef)\\b"
        },
        "general-functions": {
            "name": "support.function.greyscript",
            "match": "\\b(File|abs|acos|active_net_card|active_user|add_repo|aircrack|aireplay|airmon|allow_import|amount_mined|apply_patch|asin|atan|bitAnd|bitOr|bitXor|bitwise|bssid_name|build|buy_coin|camera_link_system|cancel_pending_trade|cd|ceil|change_password|char|check_password|check_upgrade|chmod|clear_screen|close_program|code|coin_price|command_info|connect_ethernet|connect_service|connect_wifi|copy|cos|create_folder|create_group|create_subwallet|create_user|create_wallet|current_date|current_path|date|debug_tools|decipher|decrypt|del_repo|delete|delete_all|delete_coin|delete_group|delete_mail|delete_subwallet|delete_user|device_ports|devices_lan_ip|dump_lib|encrypt|essid_name|exit|fetch|firewall_rules|flood_connection|floor|format_columns|funcRef|get_abs_path|get_address|get_balance|get_balance_subwallet|get_coin|get_coin_name|get_content|get_creator_name|get_credentials_info|get_ctf|get_custom_object|get_cycle_mining|get_description|get_files|get_folders|get_global_offers|get_greybel_util|get_info|get_lan_ip|get_mail_content|get_mined_coins|get_name|get_num_conn_gateway|get_num_portforward|get_num_users|get_pending_trade|get_pin|get_ports|get_reward|get_router|get_shell|get_subwallet|get_subwallets|get_switch|get_template|get_user|group|groups|hasIndex|has_permission|hash|home_dir|host_computer|import_code|include_lib|indexOf|indexes|insert|install|install_service|is_any_active_user|is_binary|is_closed|is_encrypted|is_folder|is_lan_ip|is_match|is_network_active|is_patched|is_root_active_user|is_symlink|is_valid_ip|join|kernel_version|lan_ip|lastIndexOf|last_transaction|launch|launch_path|len|lib_name|list|list_coins|list_global_coins|load|local_ip|locate_vehicle|log|login_wallet|lower|mail_login|map|matches|md5|mining|model|move|name|net_speed|net_use|network_devices|network_gateway|nslookup|number|overflow|override_settings|owner|parent|parent_path|path|payload|permissions|pi|ping|ping_port|player_success|poll_input|pop|port_info|port_number|print|program_path|public_ip|public_ip_pc|pull|push|range|read|reboot|remove|rename|replace|replace_regex|reset_ctf_password|reset_password|reset_password_coin|reverse|rnd|round|rshell_client|rshell_remove|rshell_server|scan|scan_address|scan_debuglib|scp|search|sell_coin|send|set_address|set_alarm|set_content|set_cycle_mining|set_group|set_info|set_owner|set_reward|show|show_history|show_nodes|show_procs|shuffle|sign|sin|size|slice|smtp_user_list|sniffer|sort|split|sqrt|start_service|start_terminal|stop_service|str|string|sum|symlink|tan|time|to_int|touch|transaction|trim|typeof|unit_testing|update|upper|used_ports|user_bank_number|user_input|user_mail_address|val|values|version|wait|wallet_username|whois|wifi_networks|yield)\\b"
        },
        "type-methods": {
            "name": "support.function.greyscript",
            "match": "\\.(File|accept_mission|access_cctv|active_net_card|add_computer|add_net_card|add_npc|add_repo|add_smart_appliance|aircrack|aireplay|airmon|allow_import|amount_mined|answer_zero_day|apply_patch|bssid_name|build|buy_coin|buy_debug_offer|buy_exploit|camera_link_system|cancel_pending_trade|change_password|check_password|check_upgrade|chmod|close_program|code|coin_price|computer|connect_ethernet|connect_service|connect_wifi|copy|create_ctf_account|create_ctf_event|create_folder|create_group|create_guild|create_mail_account|create_network|create_procedural_mission|create_program|create_subwallet|create_user|create_wallet|create_zero_day_chain|date|debug_offer|debug_tools|decipher|decrypt|del_repo|delete|delete_all|delete_coin|delete_group|delete_user|deposit|device_ports|devices_lan_ip|dump_lib|encrypt|essid_name|exploit_shop|fetch|fire_admin|fire_npc|firewall_rules|flood_connection|get_address|get_balance|get_coin|get_coin_name|get_content|get_creator_name|get_credentials_info|get_cycle_mining|get_description|get_files|get_folders|get_global_offers|get_info|get_lan_ip|get_mail_account|get_mail_content|get_mined_coins|get_name|get_num_conn_gateway|get_num_portforward|get_num_users|get_pending_trade|get_pin|get_ports|get_reward|get_subwallet|get_subwallets|get_template|get_user|grant_coins|group|groups|hasIndex|has_permission|hire_admin|hire_crown_shield|hire_npc|host_computer|indexOf|indexes|insert|install|install_service|install_smartphone_adb|is_any_active_user|is_binary|is_closed|is_encrypted|is_folder|is_match|is_network_active|is_patched|is_root_active_user|is_symlink|join|kernel_version|lastIndexOf|last_transaction|launch|len|lib_name|list_coins|list_global_coins|load|local_ip|locate_vehicle|login|login_wallet|lower|matches|mining|model|move|name|net_speed|net_use|network|network_devices|network_gateway|networks|npc_login|overflow|override_settings|owner|parent|path|payload|permissions|phone_alarm|ping|ping_port|player_success|pop|port_info|port_number|public_ip|pull|push|rate_ctf_event|read|reboot|register_password|release_library_version|remove|rename|replace|report_exploit|report_library_update|request_zero_day_mission|reset_password|reverse|rshell_client|rshell_remove|rshell_server|scan|scan_address|scp|search|seed|sell_coin|send|service_records|set_address|set_admin_restore|set_alarm|set_company_shares|set_content|set_cycle_mining|set_date|set_group|set_info|set_library_version|set_net_speed|set_owner|set_phone_alarm|set_port_library_version|set_reward|shell|show|show_history|show_nodes|show_procs|shuffle|size|smtp_user_list|snapshot|sniffer|sort|split|start_service|start_terminal|stop_service|sudo|sum|symlink|tick|to_int|touch|traffic_accident|transaction|trim|unit_testing|unlock_debug_library|update|update_service_record|upper|used_ports|val|values|version|visit_zero_day_hack_shop|wallet_username|wifi_networks)\\b"
        },
        "type-annotation": {
            "patterns": [
                {
                    "include": "#string"
                },
                {
                    "include": "#numeric"
                },
                {
                    "match": "\\b(number|string|list|map|funcRef|function|any|null|never|unknown|self)\\b",
                    "name": "support.type.primitive.greyscript"
                },
                {
                    "match": "\\bis\\b",
                    "name": "keyword.operator.type.greyscript"
                },
                {
                    "match": "[A-Za-z_][A-Za-z0-9_.]*",
                    "name": "entity.name.type.greyscript"
                },
                {
                    "match": "<",
                    "name": "punctuation.definition.typeparameters.begin.greyscript"
                },
                {
                    "match": ">",
                    "name": "punctuation.definition.typeparameters.end.greyscript"
                },
                {
                    "match": "=>|\\|",
                    "name": "keyword.operator.type.greyscript"
                },
                {
                    "match": ":",
                    "name": "keyword.operator.type.annotation.greyscript"
                }
            ]
        },
        "typed-code": {
            "patterns": [
                {
                    "match": "^\\s*(type)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]*(<)([A-Za-z_][A-Za-z0-9_, ]*)(>))?[ \\t]*(=)[ \\t]*(.*)$",
                    "captures": {
                        "1": {
                            "name": "storage.type.greybel.greyscript"
                        },
                        "2": {
                            "name": "entity.name.type.greyscript"
                        },
                        "3": {
                            "name": "punctuation.definition.typeparameters.begin.greyscript"
                        },
                        "4": {
                            "name": "entity.name.type.greyscript"
                        },
                        "5": {
                            "name": "punctuation.definition.typeparameters.end.greyscript"
                        },
                        "6": {
                            "name": "keyword.operator.assignment.greyscript"
                        },
                        "7": {
                            "patterns": [
                                {
                                    "include": "#type-annotation"
                                }
                            ]
                        }
                    }
                },
                {
                    "begin": "^\\s*(type)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]*(<)([A-Za-z_][A-Za-z0-9_, ]*)(>))?(?:[ \\t]+(extends)[ \\t]+(.*))?$",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.greybel.greyscript"
                        },
                        "2": {
                            "name": "entity.name.type.greyscript"
                        },
                        "3": {
                            "name": "punctuation.definition.typeparameters.begin.greyscript"
                        },
                        "4": {
                            "name": "entity.name.type.greyscript"
                        },
                        "5": {
                            "name": "punctuation.definition.typeparameters.end.greyscript"
                        },
                        "6": {
                            "name": "storage.modifier.greybel.greyscript"
                        },
                        "7": {
                            "patterns": [
                                {
                                    "include": "#type-annotation"
                                }
                            ]
                        }
                    },
                    "end": "^\\s*(end type)\\b",
                    "endCaptures": {
                        "1": {
                            "name": "storage.type.greybel.greyscript"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comment"
                        },
                        {
                            "match": "^\\s*(?:(readonly)[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)(\\?)?[ \\t]*(:)[ \\t]*(.*)$",
                            "captures": {
                                "1": {
                                    "name": "storage.modifier.greybel.greyscript"
                                },
                                "2": {
                                    "name": "variable.other.property.greyscript"
                                },
                                "3": {
                                    "name": "keyword.operator.optional.greybel.greyscript"
                                },
                                "4": {
                                    "name": "keyword.operator.type.annotation.greyscript"
                                },
                                "5": {
                                    "patterns": [
                                        {
                                            "include": "#type-annotation"
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(\\()([^)]*)(\\))(?:[ \\t]*(:)[ \\t]*(.*))?$",
                            "captures": {
                                "1": {
                                    "name": "entity.name.function.greyscript"
                                },
                                "3": {
                                    "patterns": [
                                        {
                                            "match": "(:)[ \\t]*([^,]*)",
                                            "captures": {
                                                "1": {
                                                    "name": "keyword.operator.type.annotation.greyscript"
                                                },
                                                "2": {
                                                    "patterns": [
                                                        {
                                                            "include": "#type-annotation"
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        {
                                            "match": "[A-Za-z_][A-Za-z0-9_]*",
                                            "name": "variable.parameter.greyscript"
                                        }
                                    ]
                                },
                                "5": {
                                    "name": "keyword.operator.type.annotation.greyscript"
                                },
                                "6": {
                                    "patterns": [
                                        {
                                            "include": "#type-annotation"
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                },
                {
                    "match": "^\\s*(let|const)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(:)[ \\t]*([^=\\n]+?)[ \\t]*(?==)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.greybel.greyscript"
                        },
                        "2": {
                            "name": "variable.other.greyscript"
                        },
                        "3": {
                            "name": "keyword.operator.type.annotation.greyscript"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "include": "#type-annotation"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "\\b(as)[ \\t]+(?![A-Za-z_][A-Za-z0-9_]*[ \\t]*[,}])([A-Za-z_][A-Za-z0-9_.]*(?:<[^>\\n]*>)?(?:[ \\t]*\\|[ \\t]*[A-Za-z_][A-Za-z0-9_.]*(?:<[^>\\n]*>)?)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.type.greyscript"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#type-annotation"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "parameter": {
            "patterns": [
                {
                    "include": "#string"
                },
                {
                    "match": "([^=\\),]+)(=[^\\),\"]+)?",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "(:)[ \\t]*(.*)",
                                    "captures": {
                                        "1": {
                                            "name": "keyword.operator.type.annotation.greyscript"
                                        },
                                        "2": {
                                            "patterns": [
                                                {
                                                    "include": "#type-annotation"
                                                }
                                            ]
                                        }
                                    }
                                },
                                {
                                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                                    "name": "variable.parameter.greyscript"
                                }
                            ]
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#string"
                                },
                                {
                                    "include": "#numeric"
                                },
                                {
                                    "include": "#constant"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "short-function-parameters": {
            "begin": "(\\()(?=[^()]*\\)[ \\t]*=>)",
            "end": "\\)",
            "patterns": [
                {
                    "include": "#parameter"
                }
            ]
        },
        "class": {
            "begin": "^\\s*(class)[ \\t]+([A-Za-z_][A-Za-z_0-9]*)(?:[ \\t]+(extends)[ \\t]+([A-Za-z_][A-Za-z_0-9.]*))?(?:[ \\t]+(implements)\\b)?",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.block.greybel.greyscript"
                },
                "2": {
                    "name": "entity.name.type.class.greybel.greyscript"
                },
                "3": {
                    "name": "storage.modifier.greybel.greyscript"
                },
                "4": {
                    "name": "entity.other.inherited-class.greybel.greyscript"
                },
                "5": {
                    "name": "storage.modifier.greybel.greyscript"
                }
            },
            "end": "\\b(end class)\\b",
            "endCaptures": {
                "1": {
                    "name": "keyword.control.block.greybel.greyscript"
                }
            },
            "patterns": [
                {
                    "include": "#class-method"
                },
                {
                    "include": "$self"
                }
            ]
        },
        "class-method": {
            "begin": "^\\s*((?:(?:private|static)[ \\t]+)*)([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?=\\()",
            "beginCaptures": {
                "1": {
                    "patterns": [
