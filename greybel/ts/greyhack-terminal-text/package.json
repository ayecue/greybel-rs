{
  "name": "greyhack-terminal-text",
  "version": "0.1.0",
  "description": "The terminal side of the greyhack-terminal-text crate: its protocol, for rendering Grey Hack's rich text as ANSI escape sequences, served by the runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "duplex-core": "^0.1.0"
  },
  "devDependencies": {
    "duplex-driver-stdio": "^0.1.0"
  }
}
