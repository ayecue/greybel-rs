{
  "name": "greyhack-world-operations",
  "version": "0.1.0",
  "description": "The host side of the greyhack-world-operations crate: its world protocol, to hand program runtimes a connection to the game server whose world they share",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "duplex-core": "^0.1.0"
  }
}
