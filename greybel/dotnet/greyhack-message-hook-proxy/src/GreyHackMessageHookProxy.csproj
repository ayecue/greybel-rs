<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 so that Unity's Mono loads it; the plugin compiles its sources into itself (see README.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>GreyHackMessageHook</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DuplexDotnet)duplex-core/src/DuplexCore.csproj" />
  </ItemGroup>
</Project>
