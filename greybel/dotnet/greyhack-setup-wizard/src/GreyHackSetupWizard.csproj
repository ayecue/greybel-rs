<Project Sdk="Microsoft.NET.Sdk">
  <!-- Setting up Grey Hack for greybel: finding the game, installing BepInEx 5 or 6, the plugins and their config. A
       library, so the command-line tool, the tests' game runner and a future wizard share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GreyHackSetupWizard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GreyHackSetupWizard.Tests" />
  </ItemGroup>

  <!-- The texts it shows, as a class generated from the .resx at build (English, the neutral language). -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Messages.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Messages.g.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>GreyHackSetupWizard.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Messages</StronglyTypedClassName>
      <PublicClass>false</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
