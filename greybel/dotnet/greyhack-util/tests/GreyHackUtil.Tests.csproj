<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/GreyHackUtil.csproj" />
    <ProjectReference Include="Fixtures/WindowGame/WindowGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures/**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GreybelDotnet" Value="$(GreybelDotnet)" />
    <AssemblyMetadata Include="GreybelRust" Value="$(GreybelRust)" />
    <AssemblyMetadata Include="GreybelContracts" Value="$(GreybelContracts)" />
  </ItemGroup>
</Project>
