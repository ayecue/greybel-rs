<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetRipper.Tpk" Version="2.0.0" />
    <PackageReference Include="AssetRipper.Tpk.TypeTrees.Json" Version="2.0.0" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(AssetsDotnet)asset-bundle/src/AssetBundle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GreyHackUtil.Tests" />
  </ItemGroup>
</Project>
