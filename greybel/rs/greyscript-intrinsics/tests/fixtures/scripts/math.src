// Grey Hack's 64-bit `bitwise` and 32-bit bit operators.
print bitwise("&", 12, 10)
print bitwise("|", 12, 10)
print bitwise("^", 12, 10)
print bitwise("~", 5)
print bitwise("<<", 1, 40)
print bitwise(">>", -16, 2)
print bitwise(">>>", -16, 60)
print bitwise("<<", 1, 65)
print bitwise("?", 1, 2)
print bitwise("&", "1", 2)
print bitwise("&", 6)
print bitAnd(2^33 + 5, 3)
print bitOr(-6, 3)
print bitXor(6, -3)
print round(2.5)
