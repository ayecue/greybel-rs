  returns File: Invalid arguments
get_shell.host_computer.create_folder(1)
  returns create_folder: Invalid arguments
get_shell.host_computer.create_user("", "x")
  returns create_user: Invalid arguments
get_shell.host_computer.create_user("a" * 16, "x")
  returns username cannot exceed the 15 character limit.
get_shell.host_computer.groups("")
  returns groups: Invalid arguments
get_shell.host_computer.File("/home").chmod("u+r", "x")
  returns chmod: Invalid arguments
get_shell.host_computer.File("/home").set_owner("bad name")
  returns Only alphanumeric characters are allowed for owner names.
get_shell.host_computer.File("/home").set_group("a" * 16)
  returns Group name cannot exceed the 15 character limit.
get_shell.host_computer.File("/home").copy(1)
  returns copy: Invalid arguments
get_shell.host_computer.File("/home").copy("/tmp", "a" * 129)
  returns copy: name cannot exceed the 128 character limit.
