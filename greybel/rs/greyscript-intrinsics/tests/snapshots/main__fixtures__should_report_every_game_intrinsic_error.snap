command_info("")
  returns command_info: Invalid arguments
command_info(1)
  returns command_info: Invalid arguments
get_shell(1)
  returns get_shell: Invalid arguments
get_shell.x = 1
  raises can't set an indexed element in this type
get_shell.__isa.x = 1
  raises can't set an indexed element in this type
s = get_shell; s["x"] = 1
  raises can't set an indexed element in this type
get_shell.pop
  raises pop: This object does not allow the use of this method
get_shell.push(1)
  raises push: This object does not allow the use of this method
get_shell.remove("classID")
  raises remove: This object does not allow the use of this method
get_shell.shuffle
  raises shuffle: This object does not allow the use of this method
