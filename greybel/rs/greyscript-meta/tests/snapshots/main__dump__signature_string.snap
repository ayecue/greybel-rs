    id: split
    json:
      arguments:
        - default: ~
          label: pattern
          opt: false
          types:
            - string
        - default:
            type: string
            value: none
          label: regexOptions
          opt: false
          types:
            - string
      description: "Splits a `string` with a regular expression and returns a `list` of strings. An empty separator returns one character per list item. Invalid regex options return `\"split: Invalid regex option\"`; an invalid .NET regex pattern returns its error message as a `string`. Invalid argument types return `null`; regex timeouts still raise a runtime error."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "segments = myString.split(\" \")"
        - "if segments[0] != \"42\" then"
        - "   print(\"Invalid information spotted!\")"
        - else
        - "   print(\"Information seems valid!\")"
        - end if
      isProtected: false
      returns:
