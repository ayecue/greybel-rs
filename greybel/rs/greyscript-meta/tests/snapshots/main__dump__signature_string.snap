  to_int:
    argStrings: []
    id: to_int
    json:
      arguments: []
      description: "Parses a `string` as an invariant-culture double and returns the resulting `number`, accepting forms such as `\"1.5\"`, `\" 1e3 \"`, `\"1,000\"`, and `\"(5)\"`. Non-numeric text is returned unchanged, a `number` is returned as-is, and other types return `null`. The global function defaults `self` to zero."
      example:
        - "myString = \"1\""
        - print(myString.to_int + 41)
      isProtected: false
      returns:
        - string
        - number
        - "null"
