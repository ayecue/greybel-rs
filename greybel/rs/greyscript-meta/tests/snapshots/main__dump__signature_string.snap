definitions:
  code:
    argStrings: []
    id: code
    json:
      arguments: []
      description: "Returns a `number` representing the Unicode code of the first character of the `string`."
      example:
        - "myString = \"HELLO WORLD\""
        - print(myString.code)
      isProtected: false
      returns:
        - number
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  hasIndex:
    argStrings:
      - - number
    id: hasIndex
    json:
      arguments:
        - default: ~
          label: index
          opt: false
          types:
            - number
      description: "Returns one when the numeric index exists in the `string`, otherwise zero. A non-number index also returns zero."
      example:
        - "myString = \"42 as an answer is wrong\""
        - containsIndex = myString.hasIndex(1)
        - if containsIndex then
        - "   print(\"String contains index of 1.\")"
        - else
        - "   print(\"String does not contain index of 1.\")"
        - end if
      isProtected: false
      returns:
        - number
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  indexOf:
    argStrings:
      - - string
      - - number
    id: indexOf
    json:
      arguments:
        - default: ~
          label: value
          opt: false
          types:
            - string
        - default: ~
          label: after
          opt: true
          types:
            - number
      description: "Returns a `number` which indicates the first matching index of the provided value inside the `list`. Optionally a start index can be provided. In case the value does not exist inside the `string` a `null` gets returned."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "index = myString.indexOf(\"wrong\")"
        - if index != null then
        - "   print(\"Invalid information spotted at: \" + index)"
        - else
        - "   print(\"Information seems valid.\")"
        - end if
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  indexes:
    argStrings: []
    id: indexes
    json:
      arguments: []
      description: "Returns a `list` where each item is a `number` representing all available indexes in the `string`."
      example:
        - "myString = \"42\""
        - print(myString.indexes)
      isProtected: false
      returns:
        - type: list
          valueType: number
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - list<number>
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  insert:
    argStrings:
      - - number
      - - string
    id: insert
    json:
      arguments:
        - default: ~
          label: index
          opt: false
          types:
            - number
        - default: ~
          label: value
          opt: false
          types:
            - string
      description: "Returns a `string` with the newly inserted `string` at the provided index. If the passed index is not a `number`, this method throws an error, preventing further script execution."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "index = myString.lastIndexOf(\"w\") - 1"
        - "newString = myString.insert(index, \"not \")"
        - print(newString)
      isProtected: false
      returns:
        - string
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
