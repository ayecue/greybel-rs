      example:
        - "myString = \"HELLO WORLD\""
        - print(myString.lower)
      isProtected: false
      returns:
        - string
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
