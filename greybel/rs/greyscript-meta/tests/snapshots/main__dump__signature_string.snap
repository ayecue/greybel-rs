    id: replace_regex
    json:
      arguments:
        - default: ~
          label: pattern
          opt: false
          types:
            - string
        - default: ~
          label: newval
          opt: false
          types:
            - string
        - default:
            type: string
            value: none
          label: regexOptions
          opt: false
          types:
            - string
      description: "Returns a `string` with regular-expression matches replaced. Invalid regex options return `\"replace: Invalid regex option\"`; an invalid .NET regex pattern returns its error message as a `string`. Empty patterns, invalid argument types, and regex timeouts still raise runtime errors."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "newString = myString.replace(\"wrong\", \"right\")"
        - print(newString)
      isProtected: false
      returns:
        - string
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
