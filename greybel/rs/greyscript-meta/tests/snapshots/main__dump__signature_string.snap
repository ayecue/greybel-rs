    typeString: function
    variations:
      ok: []
  matches:
    argStrings:
      - - string
      - - string
    id: matches
    json:
      arguments:
        - default: ~
          label: pattern
          opt: false
          types:
            - string
        - default:
            type: string
            value: none
          label: regexOptions
          opt: false
          types:
            - string
      description: "Returns a `map` whose numeric keys are match positions and whose values are the matching strings. Invalid regex options return `\"matches: Invalid regex option\"`; an invalid .NET regex pattern returns its error message as a `string`. Empty patterns, invalid argument types, and regex timeouts still raise runtime errors. `is_match` continues to raise for invalid regex options."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "result = myString.matches(\"w\")"
        - print(result)
      isProtected: false
      returns:
        - keyType: number
          type: map
          valueType: string
        - string
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - "map<number,string>"
      - string
    returnVariations:
      ok:
        - "${regexErrorMessage}"
        - "matches: Invalid regex option"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  remove:
    argStrings:
      - - string
    id: remove
    json:
      arguments:
        - default: ~
          label: k
          opt: false
          types:
            - string
      description: "Returns a new `string` with the provided value removed. Any value other than `null` can be passed, but note that it will be cast to a string. If `null` is passed, this method will throw an error, preventing further script execution."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "newString = myString.remove(\"wrong\")"
        - "print(newString + \"right\")"
      isProtected: false
      returns:
        - string
      type: function
    origin: string
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
