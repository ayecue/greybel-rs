  get_lan_ip:
    argStrings: []
    id: get_lan_ip
    json:
      arguments: []
      description: "Returns a `string` containing the local IP address of the computer to which the port is pointing."
      example:
        - router = get_router
        - ports = router.used_ports
        - for port in ports
        - "   print(\"Port \" + port.port_number + \" is pointed to \" + port.get_lan_ip + \"!\")"
        - end for
      isProtected: false
      returns:
