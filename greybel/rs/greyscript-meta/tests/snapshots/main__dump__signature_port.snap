    id: port_number
    json:
      arguments: []
      description: "Returns the `number` which is used for the port."
      example:
        - router = get_router
        - ports = router.used_ports
        - for port in ports
        - "   print(\"Port \" + port.port_number + \" is in use!\")"
        - end for
