---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - copy
  - move
  - rename
  - path
  - is_folder
  - parent
  - name
  - is_binary
  - is_symlink
  - has_permission
  - delete
  - get_folders
  - get_files
  - permissions
  - owner
  - group
  - size
  - date
definitions:
  copy:
    argStrings:
      - - string
      - - string
    id: copy
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: path
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Copies a file or folder and returns one on success. Argument and path validation failures return error strings. If some nested items cannot be copied, returns `\"Warning: one or more files or folders cannot be copied.\"`. Read access is required, including execute permission on every parent folder; SSH encryption still raises."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
        - "copyResult = passwdFile.copy(\"/etc/\", \"duplicate\")"
        - "if typeof(copyResult) == \"string\" then"
        - "   print(\"There was an error while copying file: \" + copyResult)"
        - else
        - "   print(\"File got copied successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${destinationParentPath} not found"
        - "${sourceFilepath} not found"
        - A file cannot overwrite a folder or vice versa
        - "copy: Invalid arguments"
        - "copy: name cannot exceed the 128 character limit."
        - "Error: Invalid path"
        - "Error: only alphanumeric allowed as newname"
        - "move: path too large"
        - permission denied
        - "permission denied. ${filename} is protected."
        - The copy can not be made. Reached maximum limit
        - The copy can not be made. Reached maximum number of files in a folder
        - There is not enough free space on the hard disk.
        - Unknown error
        - "Warning: one or more files or folders cannot be copied."
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  date:
    argStrings: []
    id: date
    json:
      arguments: []
      description: "Returns the file timestamp as `\"dd/MMM/yyyy HH:mm\"` using invariant English month abbreviations, for example `\"05/Mar/2026 14:07\"`. Returns `null` if the file no longer exists. Symlinks are not followed and no permission check is performed."
      example: ~
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  delete:
    argStrings: []
    id: delete
    json:
      arguments: []
      description: "Deletes a file or folder and returns an empty `string` on complete success. Partial deletion returns `\"Warning: one or more files or folders cannot be deleted.\"`; denied access cancels the whole operation with `\"Deletion cancelled: permission denied: <path>. No files or folders were deleted.\"`. Execute permission is required on every parent folder."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - deletionResult = lsBinary.delete
        - "if typeof(deletionResult) == \"string\" and deletionResult.len > 0 then"
        - "   print(\"There was an error while deleting a file: \" + deletionResult)"
        - else
        - "   print(\"File got deleted successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "Deletion cancelled: permission denied: ${path}. No files or folders were deleted."
        - "file not found: ${path}"
        - "unknown error :/"
        - "Warning: one or more files or folders cannot be deleted."
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_files:
    argStrings: []
    id: get_files
    json:
      arguments: []
      description: "Returns a `list` of child files. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "binFolder = ftpComputer.File(\"/bin\")"
        - files = binFolder.get_files
        - for file in files
        - "   print(file.path)"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: ftpFile
        - "null"
        - string
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - list<ftpFile>
      - "null"
      - string
    returnVariations:
      ok:
        - "Permission denied: ${path}"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_folders:
    argStrings: []
    id: get_folders
    json:
      arguments: []
      description: "Returns a `list` of child folders. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "binFolder = ftpComputer.File(\"/home\")"
        - folders = binFolder.get_folders
        - for folder in folders
        - "   print(folder.path)"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: ftpFile
        - "null"
        - string
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - list<ftpFile>
      - "null"
      - string
    returnVariations:
      ok:
        - "Permission denied: ${path}"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  group:
    argStrings: []
    id: group
    json:
      arguments: []
      description: "Returns a `string` with the name of the group to which this file belongs. Group permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - "print(\"File is related to following group: \" + lsBinary.group)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  has_permission:
    argStrings:
      - - string
    id: has_permission
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: typePerm
          opt: false
          types:
            - string
      description: "Returns a `number` indicating if the user who launched the script has the requested permissions. One will indicate that the user has the correct permissions. In case permissions are lacking, the value will be zero. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. In case the file gets deleted, this method will return `null` instead."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - "print(\"Is able to execute ls: \" + lsBinary.has_permission(\"x\"))"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_binary:
    argStrings: []
    id: is_binary
    json:
      arguments: []
      description: "Returns a `number`. If the file is a binary, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - "print(\"File is a binary: \" + lsBinary.is_binary)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_folder:
    argStrings: []
    id: is_folder
    json:
      arguments: []
      description: "Returns a `number`. The value is one if the file is a folder, zero otherwise. In case the file gets deleted this method will return `null` instead."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "etcFolder = ftpComputer.File(\"/etc\")"
        - "print(\"Is a folder: \" + etcFolder.is_folder)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_symlink:
    argStrings: []
    id: is_symlink
    json:
      arguments: []
      description: "Returns a `number`. If the file is a symlink, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - "print(\"File is a symlink: \" + lsBinary.is_symlink)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  move:
    argStrings:
      - - string
      - - string
    id: move
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: path
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Moves a file or folder and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
        - "moveResult = passwdFile.move(\"/root/\", \"newFileName\")"
        - "if typeof(moveResult) == \"string\" then"
        - "   print(\"There was an error while moving file: \" + moveResult)"
        - else
        - "   print(\"File got moved successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${destinationParentPath} not found"
        - "${sourceFilepath} not found"
        - A file cannot overwrite a folder or vice versa
        - "Error: Invalid path"
        - "Error: only alphanumeric allowed as newname"
        - "move: Invalid arguments"
        - "move: name cannot exceed the 128 character limit."
        - "move: path too large"
        - permission denied
        - "permission denied. ${filename} is protected."
        - The copy can not be made. Reached maximum limit
        - The copy can not be made. Reached maximum number of files in a folder
        - There is not enough free space on the hard disk.
        - Unknown error
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  name:
    argStrings: []
    id: name
    json:
      arguments: []
      description: "Returns a `string` with the name of the file. In case the file gets deleted this method will return `null` instead."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
        - "print(\"Filename: \" + passwdFile.name)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  owner:
    argStrings: []
    id: owner
    json:
      arguments: []
      description: "Returns a `string` with the name of the file owner. User permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - "print(\"Owner of ls is: \" + lsBinary.owner)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  parent:
    argStrings: []
    id: parent
    json:
      arguments: []
      description: "Returns the parent folder of the current file or folder. In case there is no parent folder `null` will be returned instead. In case the file gets deleted this method will return `null` as well."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "etcFolder = ftpComputer.File(\"/etc\")"
        - "print(\"Parent path: \" + etcFolder.parent.path)"
      isProtected: false
      returns:
        - ftpFile
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - ftpFile
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  path:
    argStrings:
      - - number
    id: path
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: symlinkOrigPath
          opt: false
          types:
            - number
      description: "Returns a `string` containing the file path. If the file is a symlink, the optional `symlinkOrigPath` argument can be set to return the original path of the linked file instead. If the file has been deleted, this method will still return the path it had prior to deletion."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
        - "print(\"File location: \" + passwdFile.path)"
      isProtected: false
      returns:
        - string
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  permissions:
    argStrings: []
    id: permissions
    json:
      arguments: []
      description: "Returns a `string` with the current file permissions. In case the current file gets deleted, this method will return `null`. The format for this permissions `string` is as follows: `\"[fileType][wrx](u)[wrx](g)[wrx](o)\"`. The file type is either `\"d\"` in case it's a directory or `\"-\"`. The user type gets defined through three possible types: user `\"u\"`, group `\"g\"`, and other `\"o\"`. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. An example of a `string` returned by this method would be `\"-rwxr-xr-x\"`. Taking the latter as an example, the following things become clear:\n* The provided file is not a directory.\n* The user has full access.\n* The group and others have almost all permissions besides writing.\n"
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "binFolder = ftpComputer.File(\"/bin\")"
        - permissions = binFolder.permissions
        - "fileType = permissions[0]"
        - "permissionsForUser = permissions[1:4]"
        - "permissionsForGroup = permissions[4:7]"
        - "permissionsForOther = permissions[7:10]"
        - "print(\"File type: \" + fileType)"
        - "print(\"User permissions: \" + permissionsForUser)"
        - "print(\"Group permissions: \" + permissionsForGroup)"
        - "print(\"Other permissions: \" + permissionsForOther)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  rename:
    argStrings:
      - - string
    id: rename
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Rename the file with the name provided. Files can only be renamed if the user has write permissions or is root. The new filename has to be below 128 characters and alphanumeric. On failure, this method will return a `string` with details. Otherwise, this method will return an empty string. If this method is used within an SSH encryption process, an error will be thrown, causing the script execution to be interrupted. In case the provided name is `null`, this method will return a `number` with the value zero."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
        - "renameResult = passwdFile.rename(\"renamed\")"
        - "if typeof(renameResult) == \"string\" then"
        - "   print(\"There was an error while renaming file: \" + renameResult)"
        - else
        - "   print(\"File got renamed successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
    returnVariations:
      ok:
        - 0
        - "${filepath} not found"
        - "Error: name cannot exceed the limit of 128 characters."
        - "Error: only alphanumeric allowed as newname"
        - permission denied
        - permission denied. File protected
        - "There is already a file with that name, please choose another one."
        - Unknown error
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  size:
    argStrings: []
    id: size
    json:
      arguments: []
      description: "Returns a `string` with the size of the file in bytes. There is no correlation between file size and actual file content. Instead, the file size is depending on the name of the file. In case the current file gets deleted, this method will return `null`."
      example:
        - shell = get_shell
        - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
        - ftpComputer = ftpShell.host_computer
        - "lsBinary = ftpComputer.File(\"/bin/ls\")"
        - size = lsBinary.size
        - if size.to_int > 1000 then
        - "   print(\"File size is bigger than 1000 bytes.\")"
        - else
        - "   print(\"File size is below 1000 bytes.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: ftpFile
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - copy
  - move
  - rename
  - path
  - is_folder
  - parent
  - name
  - is_binary
  - is_symlink
  - has_permission
  - delete
  - get_folders
  - get_files
  - permissions
  - owner
  - group
  - size
  - date
descriptions:
  $meta:
    description: "A `ftpFile` object can be acquired by using [File](#FTPCOMPUTER_FILE). The `classID` used for this object is `\"ftpFile\"`. Game objects compare and hash by identity, and repeated retrieval of the same underlying file returns the same object. Path operations require execute permission on each parent folder."
    example: ~
  copy:
    description: "Copies a file or folder and returns one on success. Argument and path validation failures return error strings. If some nested items cannot be copied, returns `\"Warning: one or more files or folders cannot be copied.\"`. Read access is required, including execute permission on every parent folder; SSH encryption still raises."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
      - "copyResult = passwdFile.copy(\"/etc/\", \"duplicate\")"
      - "if typeof(copyResult) == \"string\" then"
      - "   print(\"There was an error while copying file: \" + copyResult)"
      - else
      - "   print(\"File got copied successfully.\")"
      - end if
  date:
    description: "Returns the file timestamp as `\"dd/MMM/yyyy HH:mm\"` using invariant English month abbreviations, for example `\"05/Mar/2026 14:07\"`. Returns `null` if the file no longer exists. Symlinks are not followed and no permission check is performed."
    example: ~
  delete:
    description: "Deletes a file or folder and returns an empty `string` on complete success. Partial deletion returns `\"Warning: one or more files or folders cannot be deleted.\"`; denied access cancels the whole operation with `\"Deletion cancelled: permission denied: <path>. No files or folders were deleted.\"`. Execute permission is required on every parent folder."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - deletionResult = lsBinary.delete
      - "if typeof(deletionResult) == \"string\" and deletionResult.len > 0 then"
      - "   print(\"There was an error while deleting a file: \" + deletionResult)"
      - else
      - "   print(\"File got deleted successfully.\")"
      - end if
  get_files:
    description: "Returns a `list` of child files. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "binFolder = ftpComputer.File(\"/bin\")"
      - files = binFolder.get_files
      - for file in files
      - "   print(file.path)"
      - end for
  get_folders:
    description: "Returns a `list` of child folders. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "binFolder = ftpComputer.File(\"/home\")"
      - folders = binFolder.get_folders
      - for folder in folders
      - "   print(folder.path)"
      - end for
  group:
    description: "Returns a `string` with the name of the group to which this file belongs. Group permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - "print(\"File is related to following group: \" + lsBinary.group)"
  has_permission:
    description: "Returns a `number` indicating if the user who launched the script has the requested permissions. One will indicate that the user has the correct permissions. In case permissions are lacking, the value will be zero. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. In case the file gets deleted, this method will return `null` instead."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - "print(\"Is able to execute ls: \" + lsBinary.has_permission(\"x\"))"
  is_binary:
    description: "Returns a `number`. If the file is a binary, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - "print(\"File is a binary: \" + lsBinary.is_binary)"
  is_folder:
    description: "Returns a `number`. The value is one if the file is a folder, zero otherwise. In case the file gets deleted this method will return `null` instead."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "etcFolder = ftpComputer.File(\"/etc\")"
      - "print(\"Is a folder: \" + etcFolder.is_folder)"
  is_symlink:
    description: "Returns a `number`. If the file is a symlink, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - "print(\"File is a symlink: \" + lsBinary.is_symlink)"
  move:
    description: "Moves a file or folder and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
      - "moveResult = passwdFile.move(\"/root/\", \"newFileName\")"
      - "if typeof(moveResult) == \"string\" then"
      - "   print(\"There was an error while moving file: \" + moveResult)"
      - else
      - "   print(\"File got moved successfully.\")"
      - end if
  name:
    description: "Returns a `string` with the name of the file. In case the file gets deleted this method will return `null` instead."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
      - "print(\"Filename: \" + passwdFile.name)"
  owner:
    description: "Returns a `string` with the name of the file owner. User permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - "print(\"Owner of ls is: \" + lsBinary.owner)"
  parent:
    description: "Returns the parent folder of the current file or folder. In case there is no parent folder `null` will be returned instead. In case the file gets deleted this method will return `null` as well."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "etcFolder = ftpComputer.File(\"/etc\")"
      - "print(\"Parent path: \" + etcFolder.parent.path)"
  path:
    description: "Returns a `string` containing the file path. If the file is a symlink, the optional `symlinkOrigPath` argument can be set to return the original path of the linked file instead. If the file has been deleted, this method will still return the path it had prior to deletion."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
      - "print(\"File location: \" + passwdFile.path)"
  permissions:
    description: "Returns a `string` with the current file permissions. In case the current file gets deleted, this method will return `null`. The format for this permissions `string` is as follows: `\"[fileType][wrx](u)[wrx](g)[wrx](o)\"`. The file type is either `\"d\"` in case it's a directory or `\"-\"`. The user type gets defined through three possible types: user `\"u\"`, group `\"g\"`, and other `\"o\"`. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. An example of a `string` returned by this method would be `\"-rwxr-xr-x\"`. Taking the latter as an example, the following things become clear:\n* The provided file is not a directory.\n* The user has full access.\n* The group and others have almost all permissions besides writing.\n"
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "binFolder = ftpComputer.File(\"/bin\")"
      - permissions = binFolder.permissions
      - "fileType = permissions[0]"
      - "permissionsForUser = permissions[1:4]"
      - "permissionsForGroup = permissions[4:7]"
      - "permissionsForOther = permissions[7:10]"
      - "print(\"File type: \" + fileType)"
      - "print(\"User permissions: \" + permissionsForUser)"
      - "print(\"Group permissions: \" + permissionsForGroup)"
      - "print(\"Other permissions: \" + permissionsForOther)"
  rename:
    description: "Rename the file with the name provided. Files can only be renamed if the user has write permissions or is root. The new filename has to be below 128 characters and alphanumeric. On failure, this method will return a `string` with details. Otherwise, this method will return an empty string. If this method is used within an SSH encryption process, an error will be thrown, causing the script execution to be interrupted. In case the provided name is `null`, this method will return a `number` with the value zero."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "passwdFile = ftpComputer.File(\"/etc/passwd\")"
      - "renameResult = passwdFile.rename(\"renamed\")"
      - "if typeof(renameResult) == \"string\" then"
      - "   print(\"There was an error while renaming file: \" + renameResult)"
      - else
      - "   print(\"File got renamed successfully.\")"
      - end if
  size:
    description: "Returns a `string` with the size of the file in bytes. There is no correlation between file size and actual file content. Instead, the file size is depending on the name of the file. In case the current file gets deleted, this method will return `null`."
    example:
      - shell = get_shell
      - "ftpShell = shell.connect_service(\"172.8.0.5\", 21, \"test\", \"test\", \"ftp\")"
      - ftpComputer = ftpShell.host_computer
      - "lsBinary = ftpComputer.File(\"/bin/ls\")"
      - size = lsBinary.size
      - if size.to_int > 1000 then
      - "   print(\"File size is bigger than 1000 bytes.\")"
      - else
      - "   print(\"File size is below 1000 bytes.\")"
      - end if
extends: map
hidden: false
