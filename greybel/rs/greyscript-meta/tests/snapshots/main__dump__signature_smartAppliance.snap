  override_settings:
    argStrings:
      - - number
      - - number
    id: override_settings
    json:
      arguments:
        - default: ~
          label: power
          opt: false
          types:
            - number
        - default: ~
          label: temperature
          opt: false
          types:
            - number
      description: "Applies the exact power and temperature required by the appliance model. Other values return `\"override_settings: invalid power or temperature for this model. Check the device manual.\"`. With the alarm enabled, returns `\"override_settings: warning: Unsafe settings applied. The safety alarm will shut down the appliance if these values are reached.\"`; the accident is triggered only after the alarm is disabled, including by a later `set_alarm(0)` call."
      example:
        - "libSmartapp = include_lib(\"/lib/libsmartappliance.so\")"
        - "overrideResult = libSmartapp.override_settings(1000, 20)"
        - if overrideResult == 1 then
        - "    print(\"Override was successful!\")"
        - else
        - "    print(\"Override failed due to: \" + overrideResult)"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: smartAppliance
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "error: Device hardware malfunction"
        - "error: No internet access."
        - "override_settings: denied: The settings are locked for security reasons."
        - "override_settings: invalid power or temperature for this model. Check the device manual."
        - "override_settings: warning: Unsafe settings applied. The safety alarm will shut down the appliance if these values are reached."
        - "Unknown error: Unable to access to local computer"
