---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - show
  - search
  - update
  - add_repo
  - del_repo
  - install
  - check_upgrade
definitions:
  add_repo:
    argStrings:
      - - string
      - - number
    id: add_repo
    json:
      arguments:
        - default: ~
          label: repository
          opt: false
          types:
            - string
        - default:
            type: number
            value: 1542
          label: port
          opt: false
          types:
            - number
      description: "Inserts a repository address into the `\"/etc/apt/sources.txt\"` file. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`. On success, it will return an empty `string`. In case of failure, it will return a `string` with an error message."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "result = aptClient.add_repo(\"177.202.15.132\")"
        - "if result == \"\" then"
        - "    print \"Addition successful!\""
        - else
        - "    print \"Error while adding: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "${repository} it is already added to sources.txt"
        - /etc/apt/sources.txt content is malformed.
        - /etc/apt/sources.txt does not exist
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  check_upgrade:
    argStrings:
      - - string
    id: check_upgrade
    json:
      arguments:
        - default: ~
          label: filePath
          opt: false
          types:
            - string
      description: "Checks if there is a newer version of the program or library in the repository. If `filePath` is anything other than a `string`, this method will return `null`. On success, it will return a `number`, which can be either zero or one. Zero indicates that there is no new version, while one indicates that there is a new version available. In case of failure, it will return a string containing an error message. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "result = aptClient.check_upgrade(\"/bin/rshell_interface\")"
        - if result == 0 then
        - "    print \"Program doesnt need an update!\""
        - else if result == 1 then
        - "    print \"Program does need an update!\""
        - else
        - "    print \"Error while checking version: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
        - "${filepath} does not exist in the server"
        - "${filepath} does not exist in this filesystem"
        - "${filepath} not found in the server"
        - "${serviceDBFile} does not exist in the server"
        - "${serviceDBFile} file content is malformed in the server"
        - /etc/apt/aptcache.bin content is malformed. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin not found. Launch apt with the update option to refresh the file
        - apt folder content does not exist in the server
        - "apt_check_upgrade: No internet access."
        - "can't connect: port ${port} not found"
        - "can't connect: port closed"
        - "can't connect: service not found behind the port ${port}"
        - "can't connect: the remote server has been temporarily disabled due to non-payment"
        - "can't connect: There is no active machine behind the port ${port}"
        - Connection refused. Address unreachable
        - Connection refused. The target is behind a firewall.
        - "connection rejected: port forward removed by admin"
        - "Fatal error:  ${filepath} not found!"
        - "Fatal error: ${filepath} corrupted!"
        - "Graphics error: ${filepath} not found!"
        - Invalid target service port configuration.
        - ip address not found
        - "Kernel panic: missing ${filepath} file!"
        - No internet access.
        - package name can not be empty
        - Remote host is down
        - "Unable to connect: invalid ${library}"
        - "Unable to connect: missing ${library}"
        - "Unable to find service ${service}"
        - "Unexpected library found. Not a valid ${library} library."
        - Unknown error
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  del_repo:
    argStrings:
      - - string
    id: del_repo
    json:
      arguments:
        - default: ~
          label: repository
          opt: false
          types:
            - string
      description: "Deletes a repository address from the `\"/etc/apt/sources.txt\"` file. If the provided repository value is anything other than a `string`, this method will return `null`. On success, it will return an empty `string`. In case of failure, it will return a `string` with an error message."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "result = aptClient.del_repo(\"177.202.15.132\")"
        - "if result == \"\" then"
        - "    print \"Deletion successful!\""
        - else
        - "    print \"Error while deleting: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "${repository} not found in sources.txt"
        - /etc/apt/sources.txt content is malformed.
        - /etc/apt/sources.txt does not exist
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  install:
    argStrings:
      - - string
      - - string
    id: install
    json:
      arguments:
        - default: ~
          label: package
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: custom_path
          opt: false
          types:
            - string
      description: "Installs a program or library from a remote repository listed in `\"/etc/apt/sources.txt\"`. If no path is specified, the program installs in `\"/lib\"` if it is a library or in `\"/bin\"` otherwise. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`. On success, this method will return a `number` with the value one. In case of failure, it will return a `string` containing an error message. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "result = aptClient.install(\"rshell_interface\")"
        - if result == 1 then
        - "    print \"Installed program successful!\""
        - else
        - "    print \"Error while installing: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${customPath} not found."
        - "${filepath} not found"
        - "${package} does not exist in the server"
        - "${package} not found in the server"
        - "${serviceDBFile} does not exist in the server"
        - /etc/apt/aptcache.bin content is malformed. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin not found. Launch apt with the update option to refresh the file
        - apt folder content does not exist in the server
        - "apt_install: No internet access."
        - "can't connect: invalid or missing kernel_router.so in the target router"
        - "can't connect: port ${port} not found"
        - "can't connect: port closed"
        - "can't connect: service not found behind the port ${port}"
        - "can't connect: the remote server has been temporarily disabled due to non-payment"
        - "can't connect: There is no active machine behind the port ${port}"
        - "can't connect: unexpected library found. Not a valid kernel_router.so library in the target router."
        - Connection refused. Address unreachable
        - Connection refused. The target is behind a firewall.
        - "connection rejected: port forward removed by admin"
        - "Fatal error:  ${filepath} not found!"
        - "Fatal error: ${filepath} corrupted!"
        - "Graphics error: ${filepath} not found!"
        - Invalid path
        - Invalid target service port configuration.
        - ip address not found
        - "Kernel panic: missing ${filepath} file!"
        - No internet access.
        - package name can not be empty
        - permission denied
        - "permission denied. ${filename} is protected"
        - Remote host is down
        - The copy can not be made. Reached maximum limit
        - The copy can not be made. Reached maximum number of files in a folder
        - There is not enough free space on the hard disk.
        - "Unable to connect: invalid ${library}"
        - "Unable to connect: missing ${library}"
        - "Unable to find service ${service}"
        - "Unexpected library found. Not a valid ${library} library."
        - Unknown error
        - unknown error
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  search:
    argStrings:
      - - string
    id: search
    json:
      arguments:
        - default: ~
          label: search
          opt: false
          types:
            - string
      description: "Search specifically looks for a package in any of the repositories listed in `\"/etc/apt/sources.txt\"`. If the provided search value is anything other than a `string`, this method will return `null`. On success, it will return a `string` containing all packages that partially match the provided search value. On failure, it will return a `string` with various error messages. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "packages = aptClient.search(\".so\")"
        - packageList = packages.split(char(10) + char(10))
        - for packageItem in packageList
        - "    entry = packageItem.split(char(10))"
        - "    if entry.len != 2 then"
        - "        print \"something wrong in: \" + entry"
        - "        continue"
        - "    end if"
        - "    packageName = entry[0]"
        - "    packageDescription = entry[1]"
        - "    print \"Title: <b>\" + packageName + \"</b>\""
        - "    print \"Description: <i>\" + packageDescription + \"</i>\""
        - "    print \"----------------------------\""
        - end for
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "${search} not found in any repository"
        - /etc/apt/aptcache.bin content is malformed. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin not found. Launch apt with the update option to refresh the file
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  show:
    argStrings:
      - - string
    id: show
    json:
      arguments:
        - default: ~
          label: repository
          opt: false
          types:
            - string
      description: "Show displays all the packages available in a repository. The repository must be listed in the `\"/etc/apt/sources.txt\"` file. If the provided repository value is anything other than a `string`, this method will return `null`. If it cannot find a repository, it will return various error messages. On success, it will return a `string` containing all packages and their descriptions, with each entry separated by a newline. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "packages = aptClient.show(\"177.202.15.132\")"
        - packageList = packages.split(char(10) + char(10))
        - packageList.pop // remove last empty item
        - for packageItem in packageList
        - "    entry = packageItem.split(char(10))"
        - "    packageName = entry[0]"
        - "    packageDescription = entry[1]"
        - "    print \"Title: <b>\" + packageName + \"</b>\""
        - "    print \"Description: <i>\" + packageDescription + \"</i>\""
        - "    print \"----------------------------\""
        - end for
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "${repository} repository not found"
        - /etc/apt/aptcache.bin content is malformed. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file
        - /etc/apt/aptcache.bin not found. Launch apt with the update option to refresh the file
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  update:
    argStrings: []
    id: update
    json:
      arguments: []
      description: "Update refreshes the list of available packages after adding a new repository in `\"/etc/apt/sources.txt\"`, or if the remote repository has updated its information in `\"/server/conf/repod.conf\"`. If the update is successful, an empty `string` will be returned. In case of failure, a `string` with an error message will be returned. If for some reason the `\"/etc/apt/sources.txt\"` is malformed this method will return a number with the value zero."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - result = aptClient.update
        - "if result == \"\" then"
        - "    print \"Update successful!\""
        - else
        - "    print \"Error while updating: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - number
      type: function
    origin: aptClient
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
    returnVariations:
      ok:
        - 0
        - "${source} repository not found"
        - /etc/apt/sources.txt content is malformed
        - "apt_update: No internet access."
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - show
  - search
  - update
  - add_repo
  - del_repo
  - install
  - check_upgrade
descriptions:
  $meta:
    description: "A `aptClient` object can be obtained by using [include_lib](#GENERAL_INCLUDE_LIB). The `classID` used for this object is `\"aptclientLib\"`."
    example: ~
  add_repo:
    description: "Inserts a repository address into the `\"/etc/apt/sources.txt\"` file. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`. On success, it will return an empty `string`. In case of failure, it will return a `string` with an error message."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "result = aptClient.add_repo(\"177.202.15.132\")"
      - "if result == \"\" then"
      - "    print \"Addition successful!\""
      - else
      - "    print \"Error while adding: \" + result"
      - end if
  check_upgrade:
    description: "Checks if there is a newer version of the program or library in the repository. If `filePath` is anything other than a `string`, this method will return `null`. On success, it will return a `number`, which can be either zero or one. Zero indicates that there is no new version, while one indicates that there is a new version available. In case of failure, it will return a string containing an error message. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "result = aptClient.check_upgrade(\"/bin/rshell_interface\")"
      - if result == 0 then
      - "    print \"Program doesnt need an update!\""
      - else if result == 1 then
      - "    print \"Program does need an update!\""
      - else
      - "    print \"Error while checking version: \" + result"
      - end if
  del_repo:
    description: "Deletes a repository address from the `\"/etc/apt/sources.txt\"` file. If the provided repository value is anything other than a `string`, this method will return `null`. On success, it will return an empty `string`. In case of failure, it will return a `string` with an error message."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "result = aptClient.del_repo(\"177.202.15.132\")"
      - "if result == \"\" then"
      - "    print \"Deletion successful!\""
      - else
      - "    print \"Error while deleting: \" + result"
      - end if
  install:
    description: "Installs a program or library from a remote repository listed in `\"/etc/apt/sources.txt\"`. If no path is specified, the program installs in `\"/lib\"` if it is a library or in `\"/bin\"` otherwise. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`. On success, this method will return a `number` with the value one. In case of failure, it will return a `string` containing an error message. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "result = aptClient.install(\"rshell_interface\")"
      - if result == 1 then
      - "    print \"Installed program successful!\""
      - else
      - "    print \"Error while installing: \" + result"
      - end if
  search:
    description: "Search specifically looks for a package in any of the repositories listed in `\"/etc/apt/sources.txt\"`. If the provided search value is anything other than a `string`, this method will return `null`. On success, it will return a `string` containing all packages that partially match the provided search value. On failure, it will return a `string` with various error messages. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "packages = aptClient.search(\".so\")"
      - packageList = packages.split(char(10) + char(10))
      - for packageItem in packageList
      - "    entry = packageItem.split(char(10))"
      - "    if entry.len != 2 then"
      - "        print \"something wrong in: \" + entry"
      - "        continue"
      - "    end if"
      - "    packageName = entry[0]"
      - "    packageDescription = entry[1]"
      - "    print \"Title: <b>\" + packageName + \"</b>\""
      - "    print \"Description: <i>\" + packageDescription + \"</i>\""
      - "    print \"----------------------------\""
      - end for
  show:
    description: "Show displays all the packages available in a repository. The repository must be listed in the `\"/etc/apt/sources.txt\"` file. If the provided repository value is anything other than a `string`, this method will return `null`. If it cannot find a repository, it will return various error messages. On success, it will return a `string` containing all packages and their descriptions, with each entry separated by a newline. An invalid cache returns `\"/etc/apt/aptcache.bin is not a valid apt cache. Launch apt with the update option to refresh the file\"`."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - "packages = aptClient.show(\"177.202.15.132\")"
      - packageList = packages.split(char(10) + char(10))
      - packageList.pop // remove last empty item
      - for packageItem in packageList
      - "    entry = packageItem.split(char(10))"
      - "    packageName = entry[0]"
      - "    packageDescription = entry[1]"
      - "    print \"Title: <b>\" + packageName + \"</b>\""
      - "    print \"Description: <i>\" + packageDescription + \"</i>\""
      - "    print \"----------------------------\""
      - end for
  update:
    description: "Update refreshes the list of available packages after adding a new repository in `\"/etc/apt/sources.txt\"`, or if the remote repository has updated its information in `\"/server/conf/repod.conf\"`. If the update is successful, an empty `string` will be returned. In case of failure, a `string` with an error message will be returned. If for some reason the `\"/etc/apt/sources.txt\"` is malformed this method will return a number with the value zero."
    example:
      - "aptClient = include_lib(\"/lib/aptclient.so\")"
      - result = aptClient.update
      - "if result == \"\" then"
      - "    print \"Update successful!\""
      - else
      - "    print \"Error while updating: \" + result"
      - end if
extends: map
hidden: false
