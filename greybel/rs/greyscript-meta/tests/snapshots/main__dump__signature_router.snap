    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  kernel_version:
    argStrings: []
    id: kernel_version
    json:
      arguments: []
      description: "Returns a `string` with the version of the `kernel_router.so` library."
      example:
        - router = get_router
        - version = router.kernel_version
        - "print(\"Kernel router version: \" + version)"
      isProtected: false
      returns:
        - string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
