    typeString: function
    variations:
      ok: []
  net_speed:
    argStrings: []
    id: net_speed
    json:
      arguments: []
      description: "Returns the network connection-speed pack number: `3`, `6`, `12`, `20`, or `25` (`ISPPanel.PackID`). Returns `null` when the router cannot be resolved."
      example:
        - router = get_router
        - print(router.net_speed)
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: router
    otherLanguageDescription: ~
