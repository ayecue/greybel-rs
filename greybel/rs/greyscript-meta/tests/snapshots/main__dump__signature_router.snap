definitions:
  bssid_name:
    argStrings: []
    id: bssid_name
    json:
      arguments: []
      description: "Returns a `string` with the BSSID value of the router."
      example:
        - router = get_router
        - bssid = router.bssid_name
        - "print(\"BSSID: \" + bssid)"
      isProtected: false
      returns:
        - string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  device_ports:
    argStrings:
      - - string
    id: device_ports
    json:
      arguments:
        - default: ~
          label: address
          opt: false
          types:
            - string
      description: "Returns the open `port` objects for a LAN device, or `null` on failure. Empty or invalid addresses return error strings, including `\"device_ports: Invalid arguments\"`, instead of raising."
      example:
        - router = get_router
        - devices = router.devices_lan_ip
        - for ip in devices
        - "   ports = router.device_ports(ip)"
        - "   openPorts = []"
        - "   for port in ports"
        - "      if port.is_closed then continue"
        - "      openPorts.push(port)"
        - "   end for"
        - ""
        - "   if (openPorts.len == 0) then"
        - "      print(ip + \" has no open ports\")"
        - "   else"
        - "      print(ip + \" contains following open ports:\")"
        - "      for port in openPorts"
        - "         print(\"|-\" +  port.port_number)"
        - "      end for"
        - "   end if"
        - end for
      isProtected: false
      returns:
        - string
        - type: list
          valueType: port
        - "null"
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
      - list<port>
      - "null"
    returnVariations:
      ok:
        - "device_ports: Invalid arguments"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  devices_lan_ip:
    argStrings: []
    id: devices_lan_ip
    json:
      arguments: []
      description: "Returns a `list` where each item is a `string` representing a LAN IP address. All devices are within the network of the router and can be reached by using the `ping` method. Some of the devices might be behind a firewall."
      example:
        - router = get_router
        - devices = router.devices_lan_ip
        - for ip in devices
        - "   print(ip + \" found!\")"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - list<string>
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  essid_name:
    argStrings: []
    id: essid_name
    json:
      arguments: []
      description: "Returns a `string` with the ESSID value of the router."
      example:
        - router = get_router
        - essid = router.essid_name
        - "print(\"ESSID: \" + essid)"
      isProtected: false
      returns:
        - string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  firewall_rules:
    argStrings: []
    id: firewall_rules
    json:
      arguments: []
      description: "Returns a `list` where each item is a `string` containing a firewall rule."
      example:
