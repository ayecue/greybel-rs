    variations:
      ok: []
  ping_port:
    argStrings:
      - - number
    id: ping_port
    json:
      arguments:
        - default: ~
          label: port
          opt: false
          types:
            - number
      description: "Returns a `port` that is behind the port `number` provided. In case the `port` does not exist `null` gets returned."
      example:
        - router = get_router
        - ports = router.used_ports
        - for port in ports
        - "   pingedPort = router.ping_port(port.port_number)"
        - "   if (pingedPort == null) then continue"
        - "   print(\"Pinged \" + pingedPort.port_number)"
        - end for
      isProtected: false
      returns:
        - port
        - "null"
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - port
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  port_info:
    argStrings:
      - - port
    id: port_info
    json:
      arguments:
        - default: ~
          label: port
          opt: false
          types:
            - port
      description: "Returns a `string` with information about the provided port, including details about the running service and its version. For example, the output could be `\"http 1.0.0\"`. If the operation fails, `null` will be returned."
      example:
        - router = get_router
        - ports = router.used_ports
        - for port in ports
        - "   info = router.port_info(port)"
        - "   print(info)"
        - end for
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  public_ip:
    argStrings: []
    id: public_ip
    json:
      arguments: []
      description: "Returns a `string` with the public IP address of the router."
      example:
        - router = get_router
        - publicIp = router.public_ip
        - "print(\"Public IP: \" + publicIp)"
      isProtected: false
      returns:
        - string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  used_ports:
    argStrings: []
    id: used_ports
    json:
      arguments: []
      description: "Returns a `list` where each item is a `port` used inside the router."
      example:
        - router = get_router
        - ports = router.used_ports
        - for port in ports
        - "   print(\"Port \" + port.port_number + \" is available!\")"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: port
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - list<port>
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
