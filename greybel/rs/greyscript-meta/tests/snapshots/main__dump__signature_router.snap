        - localIp = router.local_ip
        - "print(\"Local IP: \" + localIp)"
      isProtected: false
      returns:
        - string
      type: function
    origin: router
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
