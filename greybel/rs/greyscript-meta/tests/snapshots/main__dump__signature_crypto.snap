---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - aircrack
  - airmon
  - aireplay
  - decipher
  - smtp_user_list
  - encrypt
  - decrypt
  - is_encrypted
definitions:
  aircrack:
    argStrings:
      - - string
    id: aircrack
    json:
      arguments:
        - default: ~
          label: pathFile
          opt: false
          types:
            - string
      description: "Returns the password recovered from an aireplay capture, or `null` when recovery fails. An empty path returns `\"aircrack: Invalid arguments\"`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "networks = get_shell.host_computer.wifi_networks(\"wlan0\")"
        - "firstNetwork = networks[1].split(\" \")"
        - "bssid = firstNetwork[0]"
        - "pwr = firstNetwork[1][:-1].to_int"
        - "essid = firstNetwork[2]"
        - "aireplayResult = crypto.aireplay(bssid, essid, 300000 / pwr)"
        - if (aireplayResult == null) then
        - "   result = crypto.aircrack(home_dir + \"/file.cap\")"
        - "   print(result)"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "aircrack: Invalid arguments"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  aireplay:
    argStrings:
      - - string
      - - string
      - - number
    id: aireplay
    json:
      arguments:
        - default: ~
          label: bssid
          opt: false
          types:
            - string
        - default: ~
          label: essid
          opt: false
          types:
            - string
        - default:
            type: number
            value: -1
          label: maxAcks
          opt: false
          types:
            - number
      description: "Injects wireless frames and writes `file.cap` when stopped. Invalid arguments and a disabled Wi-Fi card now return error strings instead of raising. Success returns `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "networks = get_shell.host_computer.wifi_networks(\"wlan0\")"
        - "for index in range(0, networks.len - 1)"
        - "   print(index + \".) \" + networks[index])"
        - end for
        - "selectedIndex = user_input(\"Select Wifi: \").to_int"
        - "if (typeof(selectedIndex) == \"string\" or selectedIndex < 0 or selectedIndex > networks.len - 1) then"
        - "   exit(\"Wrong index!\")"
        - end if
        - "parsed = networks[selectedIndex].split(\" \")"
        - "bssid = parsed[0]"
        - "pwr = parsed[1][:-1].to_int"
        - "essid = parsed[2]"
        - potentialAcks = 300000 / (pwr + 15)
        - "crypto.aireplay(bssid, essid, potentialAcks)"
        - "wifiPassword = crypto.aircrack(\"/home/\" + active_user + \"/file.cap\")"
        - "print(\"Wifi password for \" + essid + \" is \" + wifiPassword)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "aireplay: Invalid arguments"
        - "aireplay: no wifi card found with monitor mode enabled"
        - "Can't connect. Target is out of reach."
        - "Error: wifi card is disabled"
        - router not found!
        - "wifi_networks: wifi card is disabled"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  airmon:
    argStrings:
      - - string
      - - string
    id: airmon
    json:
      arguments:
        - default: ~
          label: option
          opt: false
          types:
            - string
        - default: ~
          label: device
          opt: false
          types:
            - string
      description: "Starts or stops monitor mode. Returns one on success, zero for an invalid option or device, and an error `string` for an unsupported or disabled card, including `\"wifi_networks: wifi card is disabled\"`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "airmonResult = crypto.airmon(\"start\", \"wlan0\")"
        - "if typeof(airmonResult) == \"string\" then"
        - "   print(\"There was an error while switching monitoring mode: \" + airmonResult)"
        - else
        - "   print(\"Monitoring mode switched successfully.\")"
        - end if
      isProtected: false
      returns:
        - number
        - string
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
    returnVariations:
      ok:
        - 0
        - 1
        - "airmon: monitor mode can only be activated on wifi cards"
        - "airmon: monitor mode is not supported by the chipset of this network card."
        - "Error: wifi card is disabled"
        - "wifi_networks: wifi card is disabled"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  decipher:
    argStrings:
      - - string
    id: decipher
    json:
      arguments:
        - default: ~
          label: encryptPass
          opt: false
          types:
            - string
      description: "Returns a decrypted password via the provided password MD5 hash. Keep in mind that this method is not decrypting a password but rather checking for existing passwords within the game world with a matching MD5 hash. So in case a password does not exist in the game world, the decryption will fail. On failure, this method will return `null`. Using this method in an SSH encryption process will cause an error to be thrown, aborting further script execution."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdContent = hostComputer.File(\"/etc/passwd\").get_content"
        - "firstAccount = passwdContent.split(char(10))[0]"
        - "parsed = firstAccount.split(\":\")"
        - "username = parsed[0]"
        - "passwordHash = parsed[1]"
        - password = crypto.decipher(passwordHash)
        - "print(\"User: \" + username)"
        - "print(\"Password: \" + password)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  decrypt:
    argStrings:
      - - string
      - - string
    id: decrypt
    json:
      arguments:
        - default: ~
          label: filePath
          opt: false
          types:
            - string
        - default: ~
          label: password
          opt: false
          types:
            - string
      description: "Decrypts the specified file using the provided key. On success, the method returns a `number` with the value one. If decryption fails, a descriptive error message is returned as a `string`. If any arguments deviate from the expected types defined in the method signature, the method returns `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "decryptionResult = crypto.decrypt(\"/etc/passwd\", \"mySecretKey\")"
        - if decryptionResult == 1 then
        - "    print(\"File got decrypted!\")"
        - else
        - "    print(\"Failed to decrypt file due to: \" + decryptionResult)"
        - end if
      isProtected: false
      returns:
        - number
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
      - "null"
    returnVariations:
      ok:
        - 1
        - "decrypt: File not found"
        - "decrypt: Incorrect password"
        - "decrypt: Invalid file path"
        - "decrypt: The file is not encrypted."
        - "Error: only alphanumeric allowed as password."
        - "Error: the password cannot exceed the limit of 15 characters."
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  encrypt:
    argStrings:
      - - string
      - - string
    id: encrypt
    json:
      arguments:
        - default: ~
          label: filePath
          opt: false
          types:
            - string
        - default: ~
          label: password
          opt: false
          types:
            - string
      description: "Encrypts the specified file using the provided key. On success, the method returns a `number` with the value one. If encryption fails, a descriptive error message is returned as a `string`. If any arguments deviate from the expected types defined in the method signature, the method returns `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "encryptionResult = crypto.encrypt(\"/etc/passwd\", \"mySecretKey\")"
        - if encryptionResult == 1 then
        - "    print(\"File got encrypted!\")"
        - else
        - "    print(\"Failed to encrypt file due to: \" + encryptionResult)"
        - end if
      isProtected: false
      returns:
        - number
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
      - "null"
    returnVariations:
      ok:
        - 1
        - "encrypt: File not found"
        - "encrypt: Invalid file path"
        - "error: file already encrypted"
        - "Error: only alphanumeric allowed as password."
        - "Error: the password cannot exceed the limit of 15 characters."
        - permission denied
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_encrypted:
    argStrings:
      - - string
    id: is_encrypted
    json:
      arguments:
        - default: ~
          label: filePath
          opt: false
          types:
            - string
      description: "Checks whether the specified file is encrypted. Returns a `number` with the value one if the file is encrypted, or zero if it is not. If the check fails (e.g., due to a missing or unreadable file), a descriptive error message is returned as a `string`. If the argument does not match the expected type, the method returns `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "isEncrypted = is_encrypted(crypto, \"/etc/passwd\")"
        - if isEncrypted == 1 then
        - "    print(\"File is encrypted!\")"
        - else
        - "    print(\"File is not encrypted!\")"
        - end if
      isProtected: false
      returns:
        - number
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
        - "is_encrypted: File not found"
        - "is_encrypted: Invalid file path"
        - permission denied
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  smtp_user_list:
    argStrings:
      - - string
      - - number
    id: smtp_user_list
    json:
      arguments:
        - default: ~
          label: ipAddress
          opt: false
          types:
            - string
        - default: ~
          label: port
          opt: false
          types:
            - number
      description: "Returns a `list` containing only the user names on the SMTP server. Connection and validation failures return an error `string`; signature mismatches return `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "print(crypto.smtp_user_list(\"192.168.0.4\", 25))"
      isProtected: false
      returns:
        - type: list
          valueType: string
        - string
        - "null"
      type: function
    origin: crypto
    otherLanguageDescription: ~
    returnStrings:
      - list<string>
      - string
      - "null"
    returnVariations:
      ok:
        - "Error: Invalid ip address"
        - "host doesn't exist"
        - host is down
        - invalid IP address
        - invalid target service
        - ip address not found
        - "port ${port} not found"
        - service not found
    tags:
      - method
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - aircrack
  - airmon
  - aireplay
  - decipher
  - smtp_user_list
  - encrypt
  - decrypt
  - is_encrypted
descriptions:
  $meta:
    description: "A `crypto` object can be obtained by using [include_lib](#GENERAL_INCLUDE_LIB). The `classID` used for this object is `\"cryptoLib\"`."
    example: ~
  aircrack:
    description: "Returns the password recovered from an aireplay capture, or `null` when recovery fails. An empty path returns `\"aircrack: Invalid arguments\"`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "networks = get_shell.host_computer.wifi_networks(\"wlan0\")"
      - "firstNetwork = networks[1].split(\" \")"
      - "bssid = firstNetwork[0]"
      - "pwr = firstNetwork[1][:-1].to_int"
      - "essid = firstNetwork[2]"
      - "aireplayResult = crypto.aireplay(bssid, essid, 300000 / pwr)"
      - if (aireplayResult == null) then
      - "   result = crypto.aircrack(home_dir + \"/file.cap\")"
      - "   print(result)"
      - end if
  aireplay:
    description: "Injects wireless frames and writes `file.cap` when stopped. Invalid arguments and a disabled Wi-Fi card now return error strings instead of raising. Success returns `null`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "networks = get_shell.host_computer.wifi_networks(\"wlan0\")"
      - "for index in range(0, networks.len - 1)"
      - "   print(index + \".) \" + networks[index])"
      - end for
      - "selectedIndex = user_input(\"Select Wifi: \").to_int"
      - "if (typeof(selectedIndex) == \"string\" or selectedIndex < 0 or selectedIndex > networks.len - 1) then"
      - "   exit(\"Wrong index!\")"
      - end if
      - "parsed = networks[selectedIndex].split(\" \")"
      - "bssid = parsed[0]"
      - "pwr = parsed[1][:-1].to_int"
      - "essid = parsed[2]"
      - potentialAcks = 300000 / (pwr + 15)
      - "crypto.aireplay(bssid, essid, potentialAcks)"
      - "wifiPassword = crypto.aircrack(\"/home/\" + active_user + \"/file.cap\")"
      - "print(\"Wifi password for \" + essid + \" is \" + wifiPassword)"
  airmon:
    description: "Starts or stops monitor mode. Returns one on success, zero for an invalid option or device, and an error `string` for an unsupported or disabled card, including `\"wifi_networks: wifi card is disabled\"`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "airmonResult = crypto.airmon(\"start\", \"wlan0\")"
      - "if typeof(airmonResult) == \"string\" then"
      - "   print(\"There was an error while switching monitoring mode: \" + airmonResult)"
      - else
      - "   print(\"Monitoring mode switched successfully.\")"
      - end if
  decipher:
    description: "Returns a decrypted password via the provided password MD5 hash. Keep in mind that this method is not decrypting a password but rather checking for existing passwords within the game world with a matching MD5 hash. So in case a password does not exist in the game world, the decryption will fail. On failure, this method will return `null`. Using this method in an SSH encryption process will cause an error to be thrown, aborting further script execution."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdContent = hostComputer.File(\"/etc/passwd\").get_content"
      - "firstAccount = passwdContent.split(char(10))[0]"
      - "parsed = firstAccount.split(\":\")"
      - "username = parsed[0]"
      - "passwordHash = parsed[1]"
      - password = crypto.decipher(passwordHash)
      - "print(\"User: \" + username)"
      - "print(\"Password: \" + password)"
  decrypt:
    description: "Decrypts the specified file using the provided key. On success, the method returns a `number` with the value one. If decryption fails, a descriptive error message is returned as a `string`. If any arguments deviate from the expected types defined in the method signature, the method returns `null`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "decryptionResult = crypto.decrypt(\"/etc/passwd\", \"mySecretKey\")"
      - if decryptionResult == 1 then
      - "    print(\"File got decrypted!\")"
      - else
      - "    print(\"Failed to decrypt file due to: \" + decryptionResult)"
      - end if
  encrypt:
    description: "Encrypts the specified file using the provided key. On success, the method returns a `number` with the value one. If encryption fails, a descriptive error message is returned as a `string`. If any arguments deviate from the expected types defined in the method signature, the method returns `null`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "encryptionResult = crypto.encrypt(\"/etc/passwd\", \"mySecretKey\")"
      - if encryptionResult == 1 then
      - "    print(\"File got encrypted!\")"
      - else
      - "    print(\"Failed to encrypt file due to: \" + encryptionResult)"
      - end if
  is_encrypted:
    description: "Checks whether the specified file is encrypted. Returns a `number` with the value one if the file is encrypted, or zero if it is not. If the check fails (e.g., due to a missing or unreadable file), a descriptive error message is returned as a `string`. If the argument does not match the expected type, the method returns `null`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "isEncrypted = is_encrypted(crypto, \"/etc/passwd\")"
      - if isEncrypted == 1 then
      - "    print(\"File is encrypted!\")"
      - else
      - "    print(\"File is not encrypted!\")"
      - end if
  smtp_user_list:
    description: "Returns a `list` containing only the user names on the SMTP server. Connection and validation failures return an error `string`; signature mismatches return `null`."
    example:
      - "crypto = include_lib(\"/lib/crypto.so\")"
      - "print(crypto.smtp_user_list(\"192.168.0.4\", 25))"
extends: map
hidden: false
