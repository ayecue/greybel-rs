---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - chmod
  - copy
  - move
  - symlink
  - rename
  - path
  - is_folder
  - parent
  - name
  - allow_import
  - get_content
  - set_content
  - is_binary
  - is_symlink
  - has_permission
  - delete
  - get_folders
  - get_files
  - permissions
  - owner
  - set_owner
  - group
  - set_group
  - size
  - date
definitions:
  allow_import:
    argStrings: []
    id: allow_import
    json:
      arguments: []
      description: "Returns a `number`. If the file is binary and can be imported by other scripts, the value will be one; otherwise, the value will be zero. In case the file gets deleted, this method will cause a crash."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"File can be imported: \" + lsBinary.allow_import)"
      isProtected: false
      returns:
        - number
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  chmod:
    argStrings:
      - - string
      - - number
    id: chmod
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: typePerm
          opt: false
          types:
            - string
        - default:
            type: number
            value: 0
          label: isRecursive
          opt: false
          types:
            - number
      description: "Changes file permissions and returns an empty `string` on success or an error `string` on failure. A non-number `isRecursive` returns `\"chmod: Invalid arguments\"`; inaccessible files can return `\"permission denied\"`."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "rootFolder = hostComputer.File(\"/bin\")"
        - oldPermissions = rootFolder.permissions
        - "rootFolder.chmod(\"o-wrx\", true)"
        - newPermissions = rootFolder.permissions
        - "print(\"Old permissions: \" + oldPermissions)"
        - "print(\"New permissions: \" + newPermissions)"
      isProtected: false
      returns:
        - string
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok:
        - "${path} not found"
        - "chmod: Invalid arguments"
        - permission denied
        - permission denied. File protected.
        - Wrong format.
    tags:
      - method
    typeString: function
    variations:
      ok: []
  copy:
    argStrings:
      - - string
      - - string
    id: copy
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: path
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Copies a file or folder and returns one on success. Argument and path validation failures return error strings. If some nested items cannot be copied, returns `\"Warning: one or more files or folders cannot be copied.\"`. Read access is required, including execute permission on every parent folder; SSH encryption still raises."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "copyResult = passwdFile.copy(\"/etc/\", \"duplicate\")"
        - "if typeof(copyResult) == \"string\" then"
        - "   print(\"There was an error while copying file: \" + copyResult)"
        - else
        - "   print(\"File got copied successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${destinationParentPath} not found"
        - "${sourceFilepath} not found"
        - A file cannot overwrite a folder or vice versa
        - "copy: Invalid arguments"
        - "copy: name cannot exceed the 128 character limit."
        - "Error: Invalid path"
        - "Error: only alphanumeric allowed as newname"
        - "move: path too large"
        - permission denied
        - "permission denied. ${filename} is protected."
        - The copy can not be made. Reached maximum limit
        - The copy can not be made. Reached maximum number of files in a folder
        - There is not enough free space on the hard disk.
        - Unknown error
        - "Warning: one or more files or folders cannot be copied."
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  date:
    argStrings: []
    id: date
    json:
      arguments: []
      description: "Returns the file timestamp as `\"dd/MMM/yyyy HH:mm\"` using invariant English month abbreviations, for example `\"05/Mar/2026 14:07\"`. Returns `null` if the file no longer exists. Symlinks are not followed and no permission check is performed."
      example: ~
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  delete:
    argStrings: []
    id: delete
    json:
      arguments: []
      description: "Deletes a file or folder and returns an empty `string` on complete success. Partial deletion returns `\"Warning: one or more files or folders cannot be deleted.\"`; denied access cancels the whole operation with `\"Deletion cancelled: permission denied: <path>. No files or folders were deleted.\"`. Execute permission is required on every parent folder."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - deletionResult = lsBinary.delete
        - "if typeof(deletionResult) == \"string\" and deletionResult.len > 0 then"
        - "   print(\"There was an error while deleting a file: \" + deletionResult)"
        - else
        - "   print(\"File got deleted successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "Deletion cancelled: permission denied: ${path}. No files or folders were deleted."
        - "file not found: ${path}"
        - "unknown error :/"
        - "Warning: one or more files or folders cannot be deleted."
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_content:
    argStrings: []
    id: get_content
    json:
      arguments: []
      description: "Returns a `string` representing the content of the file. To read a file, the user requires read access or being root. Note that you cannot read a binary file. In case of failure, `null` will be returned. If this method is used within an SSH encryption process, an error will be thrown, preventing any further script execution."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "print(\"File content: \" + passwdFile.get_content)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "can't open ${filepath}. Binary file."
        - "Error: can't find the computer of this file"
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  get_files:
    argStrings: []
    id: get_files
    json:
      arguments: []
      description: "Returns a `list` of child files. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
      example:
        - hostComputer = get_shell.host_computer
        - "binFolder = hostComputer.File(\"/bin\")"
        - files = binFolder.get_files
        - for file in files
        - "   print(file.path)"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: file
        - "null"
        - string
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - list<file>
      - "null"
      - string
    returnVariations:
      ok:
        - "Permission denied: ${path}"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_folders:
    argStrings: []
    id: get_folders
    json:
      arguments: []
      description: "Returns a `list` of child folders. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
      example:
        - hostComputer = get_shell.host_computer
        - "binFolder = hostComputer.File(\"/home\")"
        - folders = binFolder.get_folders
        - for folder in folders
        - "   print(folder.path)"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: file
        - "null"
        - string
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - list<file>
      - "null"
      - string
    returnVariations:
      ok:
        - "Permission denied: ${path}"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  group:
    argStrings: []
    id: group
    json:
      arguments: []
      description: "Returns a `string` with the name of the group to which this file belongs. Group permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"File is related to following group: \" + lsBinary.group)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  has_permission:
    argStrings:
      - - string
    id: has_permission
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: typePerm
          opt: false
          types:
            - string
      description: "Returns a `number` indicating if the user who launched the script has the requested permissions. One will indicate that the user has the correct permissions. In case permissions are lacking, the value will be zero. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. In case the file gets deleted, this method will return `null` instead."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"Is able to execute ls: \" + lsBinary.has_permission(\"x\"))"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_binary:
    argStrings: []
    id: is_binary
    json:
      arguments: []
      description: "Returns a `number`. If the file is a binary, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"File is a binary: \" + lsBinary.is_binary)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_folder:
    argStrings: []
    id: is_folder
    json:
      arguments: []
      description: "Returns a `number`. The value is one if the file is a folder, zero otherwise. In case the file gets deleted this method will return `null` instead."
      example:
        - hostComputer = get_shell.host_computer
        - "etcFolder = hostComputer.File(\"/etc\")"
        - "print(\"Is a folder: \" + etcFolder.is_folder)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_symlink:
    argStrings: []
    id: is_symlink
    json:
      arguments: []
      description: "Returns a `number`. If the file is a symlink, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"File is a symlink: \" + lsBinary.is_symlink)"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  move:
    argStrings:
      - - string
      - - string
    id: move
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: path
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Moves a file or folder and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "moveResult = passwdFile.move(\"/root/\", \"newFileName\")"
        - "if typeof(moveResult) == \"string\" then"
        - "   print(\"There was an error while moving file: \" + moveResult)"
        - else
        - "   print(\"File got moved successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${destinationParentPath} not found"
        - "${sourceFilepath} not found"
        - A file cannot overwrite a folder or vice versa
        - "Error: Invalid path"
        - "Error: only alphanumeric allowed as newname"
        - "move: Invalid arguments"
        - "move: name cannot exceed the 128 character limit."
        - "move: path too large"
        - permission denied
        - "permission denied. ${filename} is protected."
        - The copy can not be made. Reached maximum limit
        - The copy can not be made. Reached maximum number of files in a folder
        - There is not enough free space on the hard disk.
        - Unknown error
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  name:
    argStrings: []
    id: name
    json:
      arguments: []
      description: "Returns a `string` with the name of the file. In case the file gets deleted this method will return `null` instead."
      example:
        - hostComputer = get_shell.host_computer
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "print(\"Filename: \" + passwdFile.name)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  owner:
    argStrings: []
    id: owner
    json:
      arguments: []
      description: "Returns a `string` with the name of the file owner. User permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "print(\"Owner of ls is: \" + lsBinary.owner)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  parent:
    argStrings: []
    id: parent
    json:
      arguments: []
      description: "Returns the parent folder of the current file or folder. In case there is no parent folder `null` will be returned instead. In case the file gets deleted this method will return `null` as well."
      example:
        - hostComputer = get_shell.host_computer
        - "etcFolder = hostComputer.File(\"/etc\")"
        - "print(\"Parent path: \" + etcFolder.parent.path)"
      isProtected: false
      returns:
        - file
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - file
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  path:
    argStrings:
      - - number
    id: path
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: symlinkOrigPath
          opt: false
          types:
            - number
      description: "Returns a `string` containing the file path. If the file is a symlink, the optional `symlinkOrigPath` argument can be set to return the original path of the linked file instead. If the file has been deleted, this method will still return the path it had prior to deletion."
      example:
        - hostComputer = get_shell.host_computer
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "print(\"File location: \" + passwdFile.path)"
      isProtected: false
      returns:
        - string
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  permissions:
    argStrings: []
    id: permissions
    json:
      arguments: []
      description: "Returns a `string` with the current file permissions. In case the current file gets deleted, this method will return `null`. The format for this permissions `string` is as follows: `\"[fileType][wrx](u)[wrx](g)[wrx](o)\"`. The file type is either `\"d\"` in case it's a directory or `\"-\"`. The user type gets defined through three possible types: user `\"u\"`, group `\"g\"`, and other `\"o\"`. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. An example of a `string` returned by this method would be `\"-rwxr-xr-x\"`. Taking the latter as an example, the following things become clear:\n* The provided file is not a directory.\n* The user has full access.\n* The group and others have almost all permissions besides writing.\n"
      example:
        - hostComputer = get_shell.host_computer
        - "binFolder = hostComputer.File(\"/bin\")"
        - permissions = binFolder.permissions
        - "fileType = permissions[0]"
        - "permissionsForUser = permissions[1:4]"
        - "permissionsForGroup = permissions[4:7]"
        - "permissionsForOther = permissions[7:10]"
        - "print(\"File type: \" + fileType)"
        - "print(\"User permissions: \" + permissionsForUser)"
        - "print(\"Group permissions: \" + permissionsForGroup)"
        - "print(\"Other permissions: \" + permissionsForOther)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  rename:
    argStrings:
      - - string
    id: rename
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Rename the file with the name provided. Files can only be renamed if the user has write permissions or is root. The new filename has to be below 128 characters and alphanumeric. On failure, this method will return a `string` with details. Otherwise, this method will return an empty string. If this method is used within an SSH encryption process, an error will be thrown, causing the script execution to be interrupted. In case the provided name is `null`, this method will return a `number` with the value zero."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "renameResult = passwdFile.rename(\"renamed\")"
        - "if typeof(renameResult) == \"string\" then"
        - "   print(\"There was an error while renaming file: \" + renameResult)"
        - else
        - "   print(\"File got renamed successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
    returnVariations:
      ok:
        - 0
        - "${filepath} not found"
        - "Error: name cannot exceed the limit of 128 characters."
        - "Error: only alphanumeric allowed as newname"
        - permission denied
        - permission denied. File protected
        - "There is already a file with that name, please choose another one."
        - Unknown error
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  set_content:
    argStrings:
      - - string
    id: set_content
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: content
          opt: false
          types:
            - string
      description: "Saves text into a `file`. The content will not get appended to the `file`; therefore, existing content will be overridden. To set new content, the user requires write permissions or being root. Keep in mind that text files cannot exceed the character limit of 160,000. In case setting the content was successful, a `number` with the value one will be returned. Otherwise, a `string` with details will be returned. If this method is used within an SSH encryption process, an error will be thrown, preventing any further script execution. If the provided content is `null` or permissions are lacking, this method will return a `number` with the value zero. In case the file gets deleted this method will return `null`."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "passwdFile = hostComputer.File(\"/etc/passwd\")"
        - "setResult = passwdFile.set_content(\"moo\")"
        - "if typeof(setResult) == \"string\" then"
        - "   print(\"There was an error while setting file content: \" + setResult)"
        - else if setResult == 0 then
        - "   print(\"Unable to set content of file!\")"
        - else
        - "   print(\"File content got changed successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "can't open ${filepath}. Binary file."
        - "I can't save the file. The maximum of 160,000 characters has been exceeded."
        - "set_content: unable to use this method in encryption configuration"
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  set_group:
    argStrings:
      - - string
      - - number
    id: set_group
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: groupname
          opt: false
          types:
            - string
        - default:
            type: number
            value: 0
          label: isRecursive
          opt: false
          types:
            - number
      description: "Changes the file group and returns an empty `string` on success. Invalid group values and a non-number recursive flag return error strings instead of raising. Missing files and other signature mismatches return `null`."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "ownerResult = lsBinary.set_group(\"root\")"
        - "if ownerResult != \"\" then"
        - "   print(\"There was an error while changing group: \" + ownerResult)"
        - else
        - "   print(\"File group changed successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - Group name cannot exceed the 15 character limit.
        - Only alphanumeric characters are allowed for group names.
        - Permission denied
        - "set_group: Invalid arguments"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  set_owner:
    argStrings:
      - - string
      - - number
    id: set_owner
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: owner
          opt: false
          types:
            - string
        - default:
            type: number
            value: 0
          label: isRecursive
          opt: false
          types:
            - number
      description: "Changes the file owner and returns an empty `string` on success. Invalid owner values and a non-number recursive flag return error strings instead of raising. Missing files and other signature mismatches return `null`."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - "ownerResult = lsBinary.set_owner(\"root\")"
        - "if ownerResult != \"\" then"
        - "   print(\"There was an error while changing owner: \" + ownerResult)"
        - else
        - "   print(\"File owner changed successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - Only alphanumeric characters are allowed for owner names.
        - Owner cannot exceed the 15 character limit.
        - Permission denied
        - "set_owner: Invalid arguments"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  size:
    argStrings: []
    id: size
    json:
      arguments: []
      description: "Returns a `string` with the size of the file in bytes. There is no correlation between file size and actual file content. Instead, the file size is depending on the name of the file. In case the current file gets deleted, this method will return `null`."
      example:
        - hostComputer = get_shell.host_computer
        - "lsBinary = hostComputer.File(\"/bin/ls\")"
        - size = lsBinary.size
        - if size.to_int > 1000 then
        - "   print(\"File size is bigger than 1000 bytes.\")"
        - else
        - "   print(\"File size is below 1000 bytes.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  symlink:
    argStrings:
      - - string
      - - string
    id: symlink
    json:
      arguments:
        - default:
            type: string
            value: ""
          label: path
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: newName
          opt: false
          types:
            - string
      description: "Creates a symlink and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
      example:
        - "hostComputer = get_shell(\"root\", \"test\").host_computer"
        - "lsFile = hostComputer.File(\"/bin/ls\")"
        - "symResult = lsFile.symlink(\"/bin\", \"alternativeLS\")"
        - "if typeof(symResult) == \"string\" then"
        - "   print(\"There was an error while creating symlink: \" + symResult)"
        - else
        - "   print(\"Symlink got created successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: file
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "${filename} file exists"
        - "Can't create file ${pathFolderDest}/${filename}. Permission denied"
        - "Can't create file. Reached maximum limit"
        - "Can't create file. Unknown error"
        - "Can't create folder. Reached maximum limit"
        - "Error: empty destination path"
        - "Error: invalid path"
        - "Error: name cannot exceed the limit of 128 characters."
        - "Error: only alphanumeric allowed as folder name."
        - "Error: only alphanumeric allowed as newname"
        - Invalid path
        - "move: name cannot exceed the 128 character limit."
        - permission denied
        - "symlink: Invalid arguments"
        - "symlink: path too large"
        - The copy can not be made. Reached maximum number of files in a folder
        - The file already exists
        - The maximum number of subfolders has been exceeded
        - There is not enough free space on the hard disk.
        - Unknown error.
    tags:
      - method
      - ssh incompatible
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - chmod
  - copy
  - move
  - symlink
  - rename
  - path
  - is_folder
  - parent
  - name
  - allow_import
  - get_content
  - set_content
  - is_binary
  - is_symlink
  - has_permission
  - delete
  - get_folders
  - get_files
  - permissions
  - owner
  - set_owner
  - group
  - set_group
  - size
  - date
descriptions:
  $meta:
    description: "A `file` object can be acquired by either using [File](#COMPUTER_FILE) or [overflow](#METALIB_OVERFLOW). The `classID` used for this object is `\"file\"`. Game objects compare and hash by identity, and repeated retrieval of the same underlying file returns the same object. Path operations require execute permission on each parent folder."
    example: ~
  allow_import:
    description: "Returns a `number`. If the file is binary and can be imported by other scripts, the value will be one; otherwise, the value will be zero. In case the file gets deleted, this method will cause a crash."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"File can be imported: \" + lsBinary.allow_import)"
  chmod:
    description: "Changes file permissions and returns an empty `string` on success or an error `string` on failure. A non-number `isRecursive` returns `\"chmod: Invalid arguments\"`; inaccessible files can return `\"permission denied\"`."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "rootFolder = hostComputer.File(\"/bin\")"
      - oldPermissions = rootFolder.permissions
      - "rootFolder.chmod(\"o-wrx\", true)"
      - newPermissions = rootFolder.permissions
      - "print(\"Old permissions: \" + oldPermissions)"
      - "print(\"New permissions: \" + newPermissions)"
  copy:
    description: "Copies a file or folder and returns one on success. Argument and path validation failures return error strings. If some nested items cannot be copied, returns `\"Warning: one or more files or folders cannot be copied.\"`. Read access is required, including execute permission on every parent folder; SSH encryption still raises."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "copyResult = passwdFile.copy(\"/etc/\", \"duplicate\")"
      - "if typeof(copyResult) == \"string\" then"
      - "   print(\"There was an error while copying file: \" + copyResult)"
      - else
      - "   print(\"File got copied successfully.\")"
      - end if
  date:
    description: "Returns the file timestamp as `\"dd/MMM/yyyy HH:mm\"` using invariant English month abbreviations, for example `\"05/Mar/2026 14:07\"`. Returns `null` if the file no longer exists. Symlinks are not followed and no permission check is performed."
    example: ~
  delete:
    description: "Deletes a file or folder and returns an empty `string` on complete success. Partial deletion returns `\"Warning: one or more files or folders cannot be deleted.\"`; denied access cancels the whole operation with `\"Deletion cancelled: permission denied: <path>. No files or folders were deleted.\"`. Execute permission is required on every parent folder."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - deletionResult = lsBinary.delete
      - "if typeof(deletionResult) == \"string\" and deletionResult.len > 0 then"
      - "   print(\"There was an error while deleting a file: \" + deletionResult)"
      - else
      - "   print(\"File got deleted successfully.\")"
      - end if
  get_content:
    description: "Returns a `string` representing the content of the file. To read a file, the user requires read access or being root. Note that you cannot read a binary file. In case of failure, `null` will be returned. If this method is used within an SSH encryption process, an error will be thrown, preventing any further script execution."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "print(\"File content: \" + passwdFile.get_content)"
  get_files:
    description: "Returns a `list` of child files. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
    example:
      - hostComputer = get_shell.host_computer
      - "binFolder = hostComputer.File(\"/bin\")"
      - files = binFolder.get_files
      - for file in files
      - "   print(file.path)"
      - end for
  get_folders:
    description: "Returns a `list` of child folders. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
    example:
      - hostComputer = get_shell.host_computer
      - "binFolder = hostComputer.File(\"/home\")"
      - folders = binFolder.get_folders
      - for folder in folders
      - "   print(folder.path)"
      - end for
  group:
    description: "Returns a `string` with the name of the group to which this file belongs. Group permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"File is related to following group: \" + lsBinary.group)"
  has_permission:
    description: "Returns a `number` indicating if the user who launched the script has the requested permissions. One will indicate that the user has the correct permissions. In case permissions are lacking, the value will be zero. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. In case the file gets deleted, this method will return `null` instead."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"Is able to execute ls: \" + lsBinary.has_permission(\"x\"))"
  is_binary:
    description: "Returns a `number`. If the file is a binary, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"File is a binary: \" + lsBinary.is_binary)"
  is_folder:
    description: "Returns a `number`. The value is one if the file is a folder, zero otherwise. In case the file gets deleted this method will return `null` instead."
    example:
      - hostComputer = get_shell.host_computer
      - "etcFolder = hostComputer.File(\"/etc\")"
      - "print(\"Is a folder: \" + etcFolder.is_folder)"
  is_symlink:
    description: "Returns a `number`. If the file is a symlink, the value will be one; otherwise, it will be zero. In case the file gets deleted, this method will return `null` instead."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"File is a symlink: \" + lsBinary.is_symlink)"
  move:
    description: "Moves a file or folder and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "moveResult = passwdFile.move(\"/root/\", \"newFileName\")"
      - "if typeof(moveResult) == \"string\" then"
      - "   print(\"There was an error while moving file: \" + moveResult)"
      - else
      - "   print(\"File got moved successfully.\")"
      - end if
  name:
    description: "Returns a `string` with the name of the file. In case the file gets deleted this method will return `null` instead."
    example:
      - hostComputer = get_shell.host_computer
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "print(\"Filename: \" + passwdFile.name)"
  owner:
    description: "Returns a `string` with the name of the file owner. User permissions get applied to whoever is the owner of a file. In case the current file gets deleted, this method will return `null`."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "print(\"Owner of ls is: \" + lsBinary.owner)"
  parent:
    description: "Returns the parent folder of the current file or folder. In case there is no parent folder `null` will be returned instead. In case the file gets deleted this method will return `null` as well."
    example:
      - hostComputer = get_shell.host_computer
      - "etcFolder = hostComputer.File(\"/etc\")"
      - "print(\"Parent path: \" + etcFolder.parent.path)"
  path:
    description: "Returns a `string` containing the file path. If the file is a symlink, the optional `symlinkOrigPath` argument can be set to return the original path of the linked file instead. If the file has been deleted, this method will still return the path it had prior to deletion."
    example:
      - hostComputer = get_shell.host_computer
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "print(\"File location: \" + passwdFile.path)"
  permissions:
    description: "Returns a `string` with the current file permissions. In case the current file gets deleted, this method will return `null`. The format for this permissions `string` is as follows: `\"[fileType][wrx](u)[wrx](g)[wrx](o)\"`. The file type is either `\"d\"` in case it's a directory or `\"-\"`. The user type gets defined through three possible types: user `\"u\"`, group `\"g\"`, and other `\"o\"`. There are three different permission types: read `\"r\"`, write `\"w\"`, and execute `\"x\"`. An example of a `string` returned by this method would be `\"-rwxr-xr-x\"`. Taking the latter as an example, the following things become clear:\n* The provided file is not a directory.\n* The user has full access.\n* The group and others have almost all permissions besides writing.\n"
    example:
      - hostComputer = get_shell.host_computer
      - "binFolder = hostComputer.File(\"/bin\")"
      - permissions = binFolder.permissions
      - "fileType = permissions[0]"
      - "permissionsForUser = permissions[1:4]"
      - "permissionsForGroup = permissions[4:7]"
      - "permissionsForOther = permissions[7:10]"
      - "print(\"File type: \" + fileType)"
      - "print(\"User permissions: \" + permissionsForUser)"
      - "print(\"Group permissions: \" + permissionsForGroup)"
      - "print(\"Other permissions: \" + permissionsForOther)"
  rename:
    description: "Rename the file with the name provided. Files can only be renamed if the user has write permissions or is root. The new filename has to be below 128 characters and alphanumeric. On failure, this method will return a `string` with details. Otherwise, this method will return an empty string. If this method is used within an SSH encryption process, an error will be thrown, causing the script execution to be interrupted. In case the provided name is `null`, this method will return a `number` with the value zero."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "renameResult = passwdFile.rename(\"renamed\")"
      - "if typeof(renameResult) == \"string\" then"
      - "   print(\"There was an error while renaming file: \" + renameResult)"
      - else
      - "   print(\"File got renamed successfully.\")"
      - end if
  set_content:
    description: "Saves text into a `file`. The content will not get appended to the `file`; therefore, existing content will be overridden. To set new content, the user requires write permissions or being root. Keep in mind that text files cannot exceed the character limit of 160,000. In case setting the content was successful, a `number` with the value one will be returned. Otherwise, a `string` with details will be returned. If this method is used within an SSH encryption process, an error will be thrown, preventing any further script execution. If the provided content is `null` or permissions are lacking, this method will return a `number` with the value zero. In case the file gets deleted this method will return `null`."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "passwdFile = hostComputer.File(\"/etc/passwd\")"
      - "setResult = passwdFile.set_content(\"moo\")"
      - "if typeof(setResult) == \"string\" then"
      - "   print(\"There was an error while setting file content: \" + setResult)"
      - else if setResult == 0 then
      - "   print(\"Unable to set content of file!\")"
      - else
      - "   print(\"File content got changed successfully.\")"
      - end if
  set_group:
    description: "Changes the file group and returns an empty `string` on success. Invalid group values and a non-number recursive flag return error strings instead of raising. Missing files and other signature mismatches return `null`."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "ownerResult = lsBinary.set_group(\"root\")"
      - "if ownerResult != \"\" then"
      - "   print(\"There was an error while changing group: \" + ownerResult)"
      - else
      - "   print(\"File group changed successfully.\")"
      - end if
  set_owner:
    description: "Changes the file owner and returns an empty `string` on success. Invalid owner values and a non-number recursive flag return error strings instead of raising. Missing files and other signature mismatches return `null`."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - "ownerResult = lsBinary.set_owner(\"root\")"
      - "if ownerResult != \"\" then"
      - "   print(\"There was an error while changing owner: \" + ownerResult)"
      - else
      - "   print(\"File owner changed successfully.\")"
      - end if
  size:
    description: "Returns a `string` with the size of the file in bytes. There is no correlation between file size and actual file content. Instead, the file size is depending on the name of the file. In case the current file gets deleted, this method will return `null`."
    example:
      - hostComputer = get_shell.host_computer
      - "lsBinary = hostComputer.File(\"/bin/ls\")"
      - size = lsBinary.size
      - if size.to_int > 1000 then
      - "   print(\"File size is bigger than 1000 bytes.\")"
      - else
      - "   print(\"File size is below 1000 bytes.\")"
      - end if
  symlink:
    description: "Creates a symlink and returns one on success. Invalid arguments, long names, and oversized paths return error strings instead of raising. The operation requires execute permission on every parent folder; SSH encryption still raises."
    example:
      - "hostComputer = get_shell(\"root\", \"test\").host_computer"
      - "lsFile = hostComputer.File(\"/bin/ls\")"
      - "symResult = lsFile.symlink(\"/bin\", \"alternativeLS\")"
      - "if typeof(symResult) == \"string\" then"
      - "   print(\"There was an error while creating symlink: \" + symResult)"
      - else
      - "   print(\"Symlink got created successfully.\")"
      - end if
extends: map
hidden: false
