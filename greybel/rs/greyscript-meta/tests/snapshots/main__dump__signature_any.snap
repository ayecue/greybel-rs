        - default: ~
          label: index
          opt: false
          types:
            - number
        - default: ~
          label: value
          opt: false
          types:
            - any
      description: "Inserts a value into either a `list` or a `string`. If the passed index is not a `number`, this method throws an error, preventing further script execution."
      example:
        - "list = [2, 3, 4]"
        - "list.insert(2, 42)"
        - "print(\"List with inserted item: \" + list.join(\", \"))"
