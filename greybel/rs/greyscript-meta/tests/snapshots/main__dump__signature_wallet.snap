---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - list_coins
  - get_balance
  - buy_coin
  - sell_coin
  - get_pending_trade
  - cancel_pending_trade
  - get_global_offers
  - list_global_coins
  - show_nodes
  - reset_password
  - get_pin
definitions:
  buy_coin:
    argStrings:
      - - string
      - - number
      - - number
      - - string
    id: buy_coin
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
        - default: ~
          label: coin_amount
          opt: false
          types:
            - number
        - default: ~
          label: unit_price
          opt: false
          types:
            - number
        - default: ~
          label: subwalletUser
          opt: false
          types:
            - string
      description: "Publishes a coin purchase offer, returning one on success or an error `string` on failure. Signature mismatches return `\"buy_coin: Invalid arguments\"` instead of raising."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = login_wallet(blockchain, \"test\", \"test\")"
        - "result = wallet.buy_coin(\"test\", 100, 20, \"test\")"
        - if result == 1 then
        - "    print \"Sucessfully created purchase offer!\""
        - else
        - "    print \"Failed: \" + result"
        - end if
      isProtected: false
      returns:
        - number
        - string
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
    returnVariations:
      ok:
        - 1
        - "buy_coin: Invalid arguments"
        - No internet access.
        - "sell_coin: coin amount and proposed price cannot be 0."
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  cancel_pending_trade:
    argStrings:
      - - string
    id: cancel_pending_trade
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Cancel any pending offer of a certain coin. On success, an empty `string` will be returned. On failure, a `string` with an error message will be returned. Any deviation from the method signature will result in `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "if wallet.cancel_pending_trade(\"test\") == \"\" then"
        - "    print \"Trade got canceled!\""
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_balance:
    argStrings:
      - - string
    id: get_balance
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Returns a `number` of coins of a given currency. In case of error, a `string` with the details is returned. If the passed coinName is anything other than a `string` this method will return `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - for coinName in wallet.list_coins
        - "    print \"You have \" + wallet.get_balance(coinName) + \" coins of the currency \"\"\" + coinName + \"\"\"\""
        - end for
      isProtected: false
      returns:
        - number
        - string
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
      - "null"
    returnVariations:
      ok:
        - "Error: wallet does not exist/incorrect credentials."
        - "get_balance: wallet does not have coins in the selected currency"
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_global_offers:
    argStrings:
      - - string
    id: get_global_offers
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Returns a `map` with all the offers made by any player of a given currency. The key of the `map` represents the WalletID of the player who has made the offer, and the value of the `map` is a `list` where index 0 represents the type of offer with a `string` (Buy/Sell), index 1 represents the amount to sell or buy, and index 2 represents the price per unit. In case of failure, this method returns a `string` with details. Any deviation from the method signature will result in `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "for item in wallet.get_global_offers(\"test\")"
        - "    walletId = item.key"
        - "    trade = item.value"
        - "    isBuying = trade[0] == \"Buy\""
        - "    quantity = trade[1]"
        - "    unitPrice = trade[2]"
        - "    print \"-\" * 10"
        - "    print \"<b>\" + walletId + \"</b>\""
        - "    if isBuying then"
        - "        print \"<color=green>Is buying</color>\""
        - "    else"
        - "        print \"<color=yellow>Is selling</color>\""
        - "    end if"
        - "    print quantity + \" coins with a unit price of \" + unitPrice"
        - end for
      isProtected: false
      returns:
        - string
        - keyType: string
          type: map
          valueType:
            type: list
            valueType: any
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "map<string,list<any>>"
      - "null"
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_pending_trade:
    argStrings:
      - - string
    id: get_pending_trade
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Returns a `list` with the pending sale or purchase offer of this wallet for a certain currency. Index 0 of the `list` represents the type of offer with a `string` (Buy/Sell), index 1 represents the quantity to be sold or bought, and index 2 represents the price per unit. On failure, this method will return a `string` with details. Any deviation from the method signature will result in a `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "result = wallet.get_pending_trade(\"test\")"
        - "isBuying = result[0] == \"Buy\""
        - "quantity = result[1]"
        - "unitPrice = result[2]"
        - "currentBalance = wallet.get_balance(\"test\")"
        - if isBuying then
        - "    print \"After buying was successful your balance will be \" + (quantity * unitPrice + currentBalance)"
        - else
        - "    print \"After selling was successful your balance will be \" + (currentBalance - quantity * unitPrice)"
        - end if
      isProtected: false
      returns:
        - string
        - type: list
          valueType: any
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
      - list<any>
      - "null"
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_pin:
    argStrings: []
    id: get_pin
    json:
      arguments: []
      description: "Returns a `string` with a PIN that refreshes every few minutes. This PIN is used to obtain an account in cryptocurrency services."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - myShell = get_shell
        - myComputer = myShell.host_computer
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "myComputer.touch(\"/root\", \"pin_launch.src\")"
        - "myFile = myComputer.File(\"/root/pin_launch.src\")"
        - "myFile.set_content(\""
        - "    blockchain = include_lib(\"\"/lib/blockchain.so\"\")"
        - "    myShell = get_shell"
        - "    myComputer = myShell.host_computer"
        - "    wallet = blockchain.login_wallet(\"\"test\"\", \"\"test\"\")"
        - "    if params[0] ==  wallet.get_pin then"
        - "        get_custom_object.secret = \"\"The answer is 42\"\""
        - "    else"
        - "        get_custom_object.secret = \"\"The answer is 10053\"\""
        - "    end if"
        - "\")"
        - "myShell.build(\"/root/pin_launch.src\", \"/root\")"
        - myFile.delete
        - "myShell.launch(\"/root/pin_launch\", wallet.get_pin)"
        - "print \"The secret: \" + get_custom_object.secret"
      isProtected: false
      returns:
        - string
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  list_coins:
    argStrings: []
    id: list_coins
    json:
      arguments: []
      description: "Returns a `list` where each item is a `string` with the names of the coins available in the `wallet`. On failure this method returns a `string` with an error message."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "print \"My wallet is connected to: \" + wallet.list_coins.join(\", \")"
      isProtected: false
      returns:
        - type: list
          valueType: string
        - string
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - list<string>
      - string
    returnVariations:
      ok:
        - "Error: wallet does not exist/incorrect credentials."
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  list_global_coins:
    argStrings: []
    id: list_global_coins
    json:
      arguments: []
      description: "Returns a `list` where each item is a `string` containing the names of all the currencies that exist. In case of failure, this method returns a `string` with details."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "print \"All existing coins: \" wallet.list_global_coins.join(\", \")"
      isProtected: false
      returns:
        - string
        - type: list
          valueType: string
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
      - list<string>
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  reset_password:
    argStrings:
      - - string
    id: reset_password
    json:
      arguments:
        - default: ~
          label: newPassword
          opt: false
          types:
            - string
      description: "Change the password of the wallet. Only the account owner can perform this action. If the process is completed successfully, a `number` with the value one will be returned. In case of an error, a `string` with details will be returned. Any deviation from the method signature will result in `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = blockchain.login_wallet(\"test\", \"test\")"
        - "if wallet.reset_password(\"test\") == 1 then"
        - "    print \"You got a new password!\""
        - end if
      isProtected: false
      returns:
        - number
        - string
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
      - "null"
    returnVariations:
      ok:
        - 1
        - "Error: Only the account owner can change the password"
        - "Error: The password can only be reset once a day"
        - "Error: Wallet does not exist."
        - No internet access.
        - "reset_password: name and password cannot exceed the 16 character limit."
        - "reset_password: only alphanumeric characters are allowed as password"
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  sell_coin:
    argStrings:
      - - string
      - - number
      - - number
      - - string
    id: sell_coin
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
        - default: ~
          label: coin_amount
          opt: false
          types:
            - number
        - default: ~
          label: unit_price
          opt: false
          types:
            - number
        - default: ~
          label: subwalletUser
          opt: false
          types:
            - string
      description: "Publishes a coin sale offer, returning one on success or an error `string` on failure. Signature mismatches return `\"sell_coin: Invalid arguments\"` instead of raising."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = login_wallet(blockchain, \"test\", \"test\")"
        - "result = wallet.sell_coin(\"test\", 100, 20, \"test\")"
        - if result == 1 then
        - "    print \"Sucessfully created sell offer!\""
        - else
        - "    print \"Failed: \" + result"
        - end if
      isProtected: false
      returns:
        - number
        - string
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
    returnVariations:
      ok:
        - 1
        - No internet access.
        - "sell_coin: coin amount and proposed price cannot be 0."
        - "sell_coin: Invalid arguments"
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
  show_nodes:
    argStrings:
      - - string
    id: show_nodes
    json:
      arguments:
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Returns a `number` representing the count of devices mining a specific coin for the same `wallet`. In case of an error, a `string` with details is returned. Any deviation from the method signature will result in `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "wallet = login_wallet(blockchain, \"test\", \"test\")"
        - "print \"Active miners: \" show_nodes(wallet, \"test\")"
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: wallet
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - No internet access.
        - "show_nodes: coin does not exist"
        - "show_nodes: wallet does not exist"
        - "Unknown error: Unable to access to local computer"
    tags:
      - method
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - list_coins
  - get_balance
  - buy_coin
  - sell_coin
  - get_pending_trade
  - cancel_pending_trade
  - get_global_offers
  - list_global_coins
  - show_nodes
  - reset_password
  - get_pin
descriptions:
  $meta:
    description: "A `wallet` object can be obtained by either using [create_wallet](#BLOCKCHAIN_CREATE_WALLET) or [login_wallet](#BLOCKCHAIN_LOGIN_WALLET). The `classID` used for this object is `\"wallet\"`."
    example: ~
  buy_coin:
    description: "Publishes a coin purchase offer, returning one on success or an error `string` on failure. Signature mismatches return `\"buy_coin: Invalid arguments\"` instead of raising."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = login_wallet(blockchain, \"test\", \"test\")"
      - "result = wallet.buy_coin(\"test\", 100, 20, \"test\")"
      - if result == 1 then
      - "    print \"Sucessfully created purchase offer!\""
      - else
      - "    print \"Failed: \" + result"
      - end if
  cancel_pending_trade:
    description: "Cancel any pending offer of a certain coin. On success, an empty `string` will be returned. On failure, a `string` with an error message will be returned. Any deviation from the method signature will result in `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "if wallet.cancel_pending_trade(\"test\") == \"\" then"
      - "    print \"Trade got canceled!\""
      - end if
  get_balance:
    description: "Returns a `number` of coins of a given currency. In case of error, a `string` with the details is returned. If the passed coinName is anything other than a `string` this method will return `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - for coinName in wallet.list_coins
      - "    print \"You have \" + wallet.get_balance(coinName) + \" coins of the currency \"\"\" + coinName + \"\"\"\""
      - end for
  get_global_offers:
    description: "Returns a `map` with all the offers made by any player of a given currency. The key of the `map` represents the WalletID of the player who has made the offer, and the value of the `map` is a `list` where index 0 represents the type of offer with a `string` (Buy/Sell), index 1 represents the amount to sell or buy, and index 2 represents the price per unit. In case of failure, this method returns a `string` with details. Any deviation from the method signature will result in `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "for item in wallet.get_global_offers(\"test\")"
      - "    walletId = item.key"
      - "    trade = item.value"
      - "    isBuying = trade[0] == \"Buy\""
      - "    quantity = trade[1]"
      - "    unitPrice = trade[2]"
      - "    print \"-\" * 10"
      - "    print \"<b>\" + walletId + \"</b>\""
      - "    if isBuying then"
      - "        print \"<color=green>Is buying</color>\""
      - "    else"
      - "        print \"<color=yellow>Is selling</color>\""
      - "    end if"
      - "    print quantity + \" coins with a unit price of \" + unitPrice"
      - end for
  get_pending_trade:
    description: "Returns a `list` with the pending sale or purchase offer of this wallet for a certain currency. Index 0 of the `list` represents the type of offer with a `string` (Buy/Sell), index 1 represents the quantity to be sold or bought, and index 2 represents the price per unit. On failure, this method will return a `string` with details. Any deviation from the method signature will result in a `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "result = wallet.get_pending_trade(\"test\")"
      - "isBuying = result[0] == \"Buy\""
      - "quantity = result[1]"
      - "unitPrice = result[2]"
      - "currentBalance = wallet.get_balance(\"test\")"
      - if isBuying then
      - "    print \"After buying was successful your balance will be \" + (quantity * unitPrice + currentBalance)"
      - else
      - "    print \"After selling was successful your balance will be \" + (currentBalance - quantity * unitPrice)"
      - end if
  get_pin:
    description: "Returns a `string` with a PIN that refreshes every few minutes. This PIN is used to obtain an account in cryptocurrency services."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - myShell = get_shell
      - myComputer = myShell.host_computer
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "myComputer.touch(\"/root\", \"pin_launch.src\")"
      - "myFile = myComputer.File(\"/root/pin_launch.src\")"
      - "myFile.set_content(\""
      - "    blockchain = include_lib(\"\"/lib/blockchain.so\"\")"
      - "    myShell = get_shell"
      - "    myComputer = myShell.host_computer"
      - "    wallet = blockchain.login_wallet(\"\"test\"\", \"\"test\"\")"
      - "    if params[0] ==  wallet.get_pin then"
      - "        get_custom_object.secret = \"\"The answer is 42\"\""
      - "    else"
      - "        get_custom_object.secret = \"\"The answer is 10053\"\""
      - "    end if"
      - "\")"
      - "myShell.build(\"/root/pin_launch.src\", \"/root\")"
      - myFile.delete
      - "myShell.launch(\"/root/pin_launch\", wallet.get_pin)"
      - "print \"The secret: \" + get_custom_object.secret"
  list_coins:
    description: "Returns a `list` where each item is a `string` with the names of the coins available in the `wallet`. On failure this method returns a `string` with an error message."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "print \"My wallet is connected to: \" + wallet.list_coins.join(\", \")"
  list_global_coins:
    description: "Returns a `list` where each item is a `string` containing the names of all the currencies that exist. In case of failure, this method returns a `string` with details."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "print \"All existing coins: \" wallet.list_global_coins.join(\", \")"
  reset_password:
    description: "Change the password of the wallet. Only the account owner can perform this action. If the process is completed successfully, a `number` with the value one will be returned. In case of an error, a `string` with details will be returned. Any deviation from the method signature will result in `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = blockchain.login_wallet(\"test\", \"test\")"
      - "if wallet.reset_password(\"test\") == 1 then"
      - "    print \"You got a new password!\""
      - end if
  sell_coin:
    description: "Publishes a coin sale offer, returning one on success or an error `string` on failure. Signature mismatches return `\"sell_coin: Invalid arguments\"` instead of raising."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = login_wallet(blockchain, \"test\", \"test\")"
      - "result = wallet.sell_coin(\"test\", 100, 20, \"test\")"
      - if result == 1 then
      - "    print \"Sucessfully created sell offer!\""
      - else
      - "    print \"Failed: \" + result"
      - end if
  show_nodes:
    description: "Returns a `number` representing the count of devices mining a specific coin for the same `wallet`. In case of an error, a `string` with details is returned. Any deviation from the method signature will result in `null`."
    example:
      - "blockchain = include_lib(\"/lib/blockchain.so\")"
      - "wallet = login_wallet(blockchain, \"test\", \"test\")"
      - "print \"Active miners: \" show_nodes(wallet, \"test\")"
extends: map
hidden: false
