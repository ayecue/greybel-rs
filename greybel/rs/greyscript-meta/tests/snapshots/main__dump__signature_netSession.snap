definitions:
  dump_lib:
    argStrings: []
    id: dump_lib
    json:
      arguments: []
      description: "Returns the `metaLib` associated with the remote service. For example if the `metaxpoit` method `net_use` was used on a ssh port it will return the `metaLib` related to the ssh service. In case the port was zero is will return a `metaLib` related to the kernel router."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - metaLib = netSession.dump_lib
        - "print(\"Library: \" + metaLib.lib_name + \" - \" + metaLib.version + \" on port \" + ports[0].port_number)"
      isProtected: false
      returns:
        - metaLib
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - metaLib
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  flood_connection:
    argStrings: []
    id: flood_connection
    json:
      arguments: []
      description: "Floods the target until stopped, or reboots it once enough distinct addresses flood it concurrently. The threshold is `netSpeed * 3` when a super administrator is on the network and three quarters of that otherwise. Super-admin networks print `\"Warning: Super administrator detected. Additional DDoS traffic required.\"`; a successful reboot prints `\"remote connection interrupted\"`. Returns `null`."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - netSession.flood_connection
      isProtected: false
      returns:
        - "null"
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - "null"
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_num_conn_gateway:
    argStrings: []
    id: get_num_conn_gateway
    json:
      arguments: []
      description: "Returns the number of devices using this router as a gateway. If you obtained your `netSession` from a computer, it will fetch and return the value from its gateway router."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - "print(\"Gateway clients: \" + netSession.get_num_conn_gateway)"
      isProtected: false
      returns:
        - number
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_num_portforward:
    argStrings: []
    id: get_num_portforward
    json:
      arguments: []
      description: "Returns the number of ports forwarded by this router. If you obtained your `netSession` from a computer, it will fetch and return the value from its gateway router."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - "print(\"Port forwards: \" + netSession.get_num_portforward)"
      isProtected: false
      returns:
        - number
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  get_num_users:
    argStrings: []
    id: get_num_users
    json:
      arguments: []
      description: Returns the number of user accounts on the system.
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - "print(\"User accounts: \" + netSession.get_num_users)"
      isProtected: false
      returns:
        - number
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_any_active_user:
    argStrings: []
    id: is_any_active_user
    json:
      arguments: []
      description: "Returns a `number`. If there is an active user on the system it will be one. Otherwise, it will be zero."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - "print(\"User Active?: \" + netSession.is_any_active_user)"
      isProtected: false
      returns:
        - number
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
  is_root_active_user:
    argStrings: []
    id: is_root_active_user
    json:
      arguments: []
      description: "Returns a `number`. If there is an active root on the system it will be one. Otherwise, it will be zero."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = get_router(\"12.12.12.12\").used_ports"
        - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
        - "print(\"Root Active?: \" + netSession.is_root_active_user)"
      isProtected: false
      returns:
        - number
      type: function
    origin: netSession
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok:
        - 0
        - 1
    tags:
      - method
    typeString: function
    variations:
      ok: []
descriptionOrder:
  - $meta
  - dump_lib
  - get_num_conn_gateway
  - get_num_portforward
  - get_num_users
  - is_any_active_user
  - is_root_active_user
  - flood_connection
descriptions:
  $meta:
    description: "A `netSession` object can be obtained by using [net_use](#METAXPLOIT_NET_USE). The `classID` used for this object is `\"NetSession\"`."
    example: ~
  dump_lib:
    description: "Returns the `metaLib` associated with the remote service. For example if the `metaxpoit` method `net_use` was used on a ssh port it will return the `metaLib` related to the ssh service. In case the port was zero is will return a `metaLib` related to the kernel router."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - metaLib = netSession.dump_lib
      - "print(\"Library: \" + metaLib.lib_name + \" - \" + metaLib.version + \" on port \" + ports[0].port_number)"
  flood_connection:
    description: "Floods the target until stopped, or reboots it once enough distinct addresses flood it concurrently. The threshold is `netSpeed * 3` when a super administrator is on the network and three quarters of that otherwise. Super-admin networks print `\"Warning: Super administrator detected. Additional DDoS traffic required.\"`; a successful reboot prints `\"remote connection interrupted\"`. Returns `null`."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - netSession.flood_connection
  get_num_conn_gateway:
    description: "Returns the number of devices using this router as a gateway. If you obtained your `netSession` from a computer, it will fetch and return the value from its gateway router."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - "print(\"Gateway clients: \" + netSession.get_num_conn_gateway)"
  get_num_portforward:
    description: "Returns the number of ports forwarded by this router. If you obtained your `netSession` from a computer, it will fetch and return the value from its gateway router."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - "print(\"Port forwards: \" + netSession.get_num_portforward)"
  get_num_users:
    description: Returns the number of user accounts on the system.
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - "print(\"User accounts: \" + netSession.get_num_users)"
  is_any_active_user:
    description: "Returns a `number`. If there is an active user on the system it will be one. Otherwise, it will be zero."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - "print(\"User Active?: \" + netSession.is_any_active_user)"
  is_root_active_user:
    description: "Returns a `number`. If there is an active root on the system it will be one. Otherwise, it will be zero."
    example:
      - "metax = include_lib(\"/lib/metaxploit.so\")"
      - "ports = get_router(\"12.12.12.12\").used_ports"
      - "netSession = metax.net_use(\"12.12.12.12\", ports[0].port_number)"
      - "print(\"Root Active?: \" + netSession.is_root_active_user)"
extends: map
hidden: false
