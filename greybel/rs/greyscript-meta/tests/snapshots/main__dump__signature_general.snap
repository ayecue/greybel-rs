  fetch:
    argStrings:
      - - metaMail
    id: fetch
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - metaMail
      description: "Returns a `list` of mail summaries containing ID, sender, subject, and a 125-character preview. The account is refreshed before reading; refresh failures return `\"MetaMail: Unable to refresh mail account.\"`. Every mail method enforces a two-second cooldown after the previous mail use and returns `\"MetaMail: Wait 2 seconds before using mail again.\"` when called too soon."
      example:
        - "metaMail = mail_login(user_mail_address, \"test\")"
        - mails = fetch(metaMail)
        - "results = []"
        - for mail in mails
        - "   segments = split(mail, char(10))"
        - "   item = {}"
        - "   item.mailId = segments[2][8:]"
        - "   item.from = segments[3][6:]"
        - "   item.subject = segments[4][9:]"
        - "   item.preview = segments[5:]"
        - "   push(results, item)"
        - end for
        - print(results)
      isProtected: false
      returns:
        - type: list
          valueType: string
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - list<string>
      - string
      - "null"
    returnVariations:
      ok:
        - "fetch: No internet access."
        - "MetaMail: Unable to refresh mail account."
        - "MetaMail: Wait 2 seconds before using mail again."
        - "Unknown error: Unable to access to local computer"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  firewall_rules:
    argStrings:
      - - router
    id: firewall_rules
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - router
      description: "Returns a `list` where each item is a `string` containing a firewall rule. In case the passed object is not a `router` this method will return `null`."
      example:
        - router = get_router
        - rules = firewall_rules(router)
        - "print(\"Firewall rules: \" + join(rules, \", \"))"
      isProtected: false
      returns:
        - type: list
          valueType: string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
