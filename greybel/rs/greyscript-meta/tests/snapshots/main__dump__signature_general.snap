    typeString: function
    variations:
      ok: []
  bitwise:
    argStrings:
      - - string
      - - number
      - - number
    id: bitwise
    json:
      arguments:
        - default: ~
          label: operator
          opt: false
          types:
            - string
        - default: ~
          label: num1
          opt: false
          types:
            - number
        - default: ~
          label: num2
          opt: false
          types:
            - number
      description: "Returns a `number` by performing bitwise operations. Supported operators are: `\"~\"`, `\"&\"`, `\"|\"`, `\"^\"`, `\"<<\"`, `\">>\"`, `\">>>\"`. In case you want to use the tilde operator you only need to provide the operator and the left argument. If any of the required arguments is `null` this method will return `null`. Warning: If either operand is >= `0x80000000`, it'll always returns 0."
      example:
        - num = 5
        - "isOdd = bitwise(\"&\", num, 1) == 1"
        - if isOdd then
        - "   print(\"Number is odd.\")"
        - else
        - "   print(\"Number is even.\")"
        - end if
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - general
    typeString: function
    variations:
      ok: []
