        - default:
            type: number
            value: 0
          label: addToHistory
          opt: false
          types:
            - number
        - default:
            type: number
            value: 1
          label: echo
          opt: false
          types:
            - number
      description: "Pauses execution for terminal input. `isPassword` masks input, `anyKey` accepts one key, and `addToHistory` controls input history. `echo` defaults to one; pass zero to hide typed input. Invalid argument types, including a non-number `echo`, return `\"user_input: Invalid arguments\"`. Use during SSH encryption still raises a runtime error."
      example:
        - num = 0
        - "aboveIncludingZeroTag = \"<color=yellow>\""
        - "belowZeroTag = \"<color=red>\""
        - while (true)
        - "   clear_screen"
        - "   output = aboveIncludingZeroTag + num"
        - "   if (num < 0) then"
        - "      output = belowZeroTag + num"
        - "   end if"
        - "   print(output)"
        - "   key = user_input(\"Press arrow up/down to change value.\", false, true)"
        - "   if (key == \"UpArrow\") then"
        - "      num = num + 1"
        - "   else if (key == \"DownArrow\") then"
        - "       num = num - 1"
        - "   else"
        - "       exit(\"Bye!\")"
        - "   end if"
        - end while
      isProtected: false
      returns:
        - string
      type: function
