            - file
      description: "Returns a `list` of child folders. Returns `null` for a missing folder or non-folder object, and `\"Permission denied: <path>\"` when the folder is unreadable."
      example:
        - computer = host_computer(get_shell)
        - "binFolder = File(computer, \"/home\")"
        - folders = get_folders(binFolder)
