    id: delete
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - file
      description: "Deletes every matching ID in a `list` of mail ID strings. Returns one if at least one mail was deleted and `null` if none matched or the list is invalid. The account is refreshed first; refresh failures return `\"MetaMail: Unable to refresh mail account.\"`. Every mail method enforces a two-second cooldown after the previous mail use and returns `\"MetaMail: Wait 2 seconds before using mail again.\"` when called too soon."
      example:
        - computer = host_computer(get_shell)
        - "lsBinary = File(computer, \"/bin/ls\")"
        - deletionResult = delete(lsBinary)
        - "if typeof(deletionResult) == \"string\" and len(deletionResult) > 0 then"
        - "   print(\"There was an error while deleting a file: \" + deletionResult)"
        - else
        - "   print(\"File got deleted successfully.\")"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "Deletion cancelled: permission denied: ${path}. No files or folders were deleted."
        - "file not found: ${path}"
        - "unknown error :/"
        - "Warning: one or more files or folders cannot be deleted."
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
