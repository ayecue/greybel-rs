      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  flood_connection:
    argStrings:
      - - netSession
    id: flood_connection
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - netSession
      description: "Floods the target until stopped, or reboots it once enough distinct addresses flood it concurrently. The threshold is `netSpeed * 3` when a super administrator is on the network and three quarters of that otherwise. Super-admin networks print `\"Warning: Super administrator detected. Additional DDoS traffic required.\"`; a successful reboot prints `\"remote connection interrupted\"`. Returns `null`."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "ports = used_ports(get_router(\"12.12.12.12\"))"
        - "netSession = net_use(metax, \"12.12.12.12\", port_number(ports[0]))"
        - flood_connection(netSession)
      isProtected: false
      returns:
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  floor:
    argStrings:
      - - number
    id: floor
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: x
          opt: false
          types:
            - number
      description: "Returns `number` rounded down to the integer value of the provided `number`."
      example:
        - price = 25.43467
        - floored = floor(price * 100) / 100
        - "print(\"Floored price: \" + floored)"
      isProtected: false
      returns:
        - number
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
