  add_repo:
    argStrings:
      - - aptClient
      - - string
      - - number
    id: add_repo
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - aptClient
        - default: ~
          label: repository
          opt: false
          types:
            - string
        - default:
            type: number
            value: 1542
          label: port
          opt: false
          types:
            - number
      description: "Adds a repository address to the `\"/etc/apt/sources.txt\"` file. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`. On success, it will return an empty `string`. In case of failure, it will return a `string` with an error message."
      example:
        - "aptClient = include_lib(\"/lib/aptclient.so\")"
        - "result = add_repo(aptClient, \"177.202.15.132\")"
        - "if result == \"\" then"
        - "    print \"Addition successful!\""
        - else
        - "    print \"Error while adding: \" + result"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "${repository} it is already added to sources.txt"
        - /etc/apt/sources.txt content is malformed.
        - /etc/apt/sources.txt does not exist
        - "Unknown error: Unable to access to local computer"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  aircrack:
    argStrings:
      - - crypto
      - - string
    id: aircrack
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - crypto
        - default: ~
          label: pathFile
          opt: false
          types:
            - string
      description: "Returns the password recovered from an aireplay capture, or `null` when recovery fails. An empty path returns `\"aircrack: Invalid arguments\"`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "networks = wifi_networks(host_computer(get_shell), \"wlan0\")"
        - "firstNetwork = networks[1].split(\" \")"
        - "bssid = firstNetwork[0]"
        - "pwr = firstNetwork[1][:-1].to_int"
        - "essid = firstNetwork[2]"
        - "aireplayResult = aireplay(crypto, bssid, essid, 300000 / pwr + 15)"
        - if (aireplayResult == null) then
        - "   result = aircrack(crypto, home_dir + \"/file.cap\")"
        - "   print(result)"
        - end if
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "aircrack: Invalid arguments"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  aireplay:
    argStrings:
      - - crypto
      - - string
      - - string
      - - number
    id: aireplay
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - crypto
        - default: ~
          label: bssid
          opt: false
          types:
            - string
        - default: ~
          label: essid
          opt: false
          types:
            - string
        - default:
            type: number
            value: -1
          label: maxAcks
          opt: false
          types:
            - number
      description: "Injects wireless frames and writes `file.cap` when stopped. Invalid arguments and a disabled Wi-Fi card now return error strings instead of raising. Success returns `null`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "networks = wifi_networks(host_computer(get_shell), \"wlan0\")"
        - "for index in range(0, networks.len - 1)"
        - "   print(index + \".) \" + networks[index])"
        - end for
        - "selectedIndex = user_input(\"Select Wifi: \").to_int"
        - "if (typeof(selectedIndex) == \"string\" or selectedIndex < 0 or selectedIndex > networks.len - 1) then"
        - "   exit(\"Wrong index!\")"
        - end if
        - "parsed = networks[selectedIndex].split(\" \")"
        - "bssid = parsed[0]"
        - "pwr = parsed[1][:-1].to_int"
        - "essid = parsed[2]"
        - potentialAcks = 300000 / (pwr + 15)
        - "aireplay(crypto, bssid, essid, potentialAcks)"
        - "wifiPassword = aircrack(crypto, \"/home/\" + active_user + \"/file.cap\")"
        - "print(\"Wifi password for \" + essid + \" is \" + wifiPassword)"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "aireplay: Invalid arguments"
        - "aireplay: no wifi card found with monitor mode enabled"
        - "Can't connect. Target is out of reach."
        - "Error: wifi card is disabled"
        - router not found!
        - "wifi_networks: wifi card is disabled"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  airmon:
    argStrings:
      - - crypto
      - - string
      - - string
    id: airmon
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - crypto
        - default: ~
          label: option
          opt: false
          types:
            - string
        - default: ~
          label: device
          opt: false
          types:
            - string
      description: "Starts or stops monitor mode. Returns one on success, zero for an invalid option or device, and an error `string` for an unsupported or disabled card, including `\"wifi_networks: wifi card is disabled\"`."
      example:
        - "crypto = include_lib(\"/lib/crypto.so\")"
        - "airmonResult = airmon(crypto, \"start\", \"wlan0\")"
        - "if typeof(airmonResult) == \"string\" then"
        - "   print(\"There was an error while switching monitoring mode: \" + airmonResult)"
        - else
        - "   print(\"Monitoring mode switched successfully.\")"
        - end if
      isProtected: false
      returns:
        - number
        - string
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - number
      - string
    returnVariations:
      ok:
        - 0
        - 1
        - "airmon: monitor mode can only be activated on wifi cards"
        - "airmon: monitor mode is not supported by the chipset of this network card."
        - "Error: wifi card is disabled"
        - "wifi_networks: wifi card is disabled"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  allow_import:
    argStrings:
      - - file
    id: allow_import
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - file
      description: "Returns a `number`. If the file is binary and can be imported by other scripts, the value will be one; otherwise, the value will be zero. In case the file gets deleted, this method will cause a crash. If an invalid `file` object gets passed, this method will return `null` instead."
      example:
        - computer = host_computer(get_shell)
        - "lsBinary = File(computer, \"/bin/ls\")"
        - "print(\"File can be imported: \" + allow_import(lsBinary))"
      isProtected: false
      returns:
        - number
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - number
      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  amount_mined:
    argStrings:
      - - blockchain
      - - string
    id: amount_mined
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - blockchain
        - default: ~
          label: coinName
          opt: false
          types:
            - string
      description: "Returns a `number` representing the total amount of mined coins. In case of an error, it will return a string with details. If any of the provided parameters have a type that deviates from the defined signature, the method will return `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "mined = amount_mined(blockchain, \"test\")"
        - "if typeof(mined) == \"string\" then"
        - "    exit \"Couldnt get amount mined due to: \" + mined"
        - end if
        - "print \"Your mined amount is \" + mined"
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - "amount_mined: Coin does not exist."
        - "amount_mined: No internet access."
        - "Unknown error: Unable to access to local computer"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  apply_patch:
    argStrings:
      - - debugLibrary
      - - string
    id: apply_patch
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - debugLibrary
        - default: ~
          label: path
          opt: false
          types:
            - string
      description: "Applies a patch containing corrected code to the specified text file at the provided path. Returns a `string` with the result of the operation. If any of the provided values deviates from the defined types in the method signature, this method will return `null`."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "metaLib = load(metax, \"/lib/init.so\")"
        - "debugLib = debug_tools(metaLib, \"test\", \"test\")"
        - "print(\"Path result: \" + apply_patch(debugLib, \"/etc/passwd\"))"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - "error: file not found"
        - "error: The file to apply the patch cannot be binary"
        - "error: The patch code is not correct."
        - The patch had already been applied.
        - The patch has been applied correctly.
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  asin:
    argStrings:
      - - number
    id: asin
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: x
          opt: false
          types:
