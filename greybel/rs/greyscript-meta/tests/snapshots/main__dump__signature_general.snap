  typeof:
    argStrings:
      - - any
    id: typeof
    json:
      arguments:
        - default: ~
          label: type_object
          opt: false
          types:
            - any
      description: "Returns a `string` containing the runtime type. For maps, `classID` is read through the `__isa` prototype chain, so an inherited `classID` is honored. Game objects compare and hash by identity; retrieving the same underlying shell, computer, file, router, port, or library returns the same object again."
      example:
        - "myObj = { \"classID\": \"myType\" }"
        - "if typeof(myObj) == \"myType\" then"
        - "   print(\"Object is myType.\")"
        - else
        - "   print(\"Object is not myType.\")"
        - end if
