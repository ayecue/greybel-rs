          types:
            - number
      description: "Pauses the script execution. Optionally, the duration can be provided via the `time` argument. By default, the duration will be 1 second. The duration cannot be below 0.01 or above 300; otherwise, this method will throw a runtime exception."
      example:
        - start = time
        - wait(5)
        - elapsed = time - start
        - "print(\"Waited: \" + elapsed)"
      isProtected: false
      returns:
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - general
    typeString: function
    variations:
      ok: []
  wallet_username:
    argStrings:
      - - subWallet
    id: wallet_username
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - subWallet
      description: "Returns a `string` with the name of the `wallet` to which this subwallet belongs. If an object is passed that is not a `subWallet`, this method will return `null`."
      example:
        - "blockchain = include_lib(\"/lib/blockchain.so\")"
        - "coin = get_coin(blockchain, \"test\", \"test\", \"test\")"
        - "subWallet = get_subwallet(coin, \"test\")"
        - "print \"SubWallet username: \" + subWallet.wallet_username"
      isProtected: false
      returns:
        - string
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - "null"
    returnVariations:
      ok:
        - No internet access.
        - "Unknown error: Unable to access to local computer"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  whois:
    argStrings:
      - - string
    id: whois
    json:
      arguments:
        - default: ~
          label: address
          opt: false
          types:
            - string
      description: "Returns administrator information for an IP address or an error `string`. Invalid or empty arguments return `\"whois: Invalid arguments\"`. The result no longer appends `[Neurobox Network]` for Neurobox networks."
      example:
        - "adminInfo = whois(\"12.12.12.12\")"
        - infoLines = adminInfo.split(char(10))
        - "infoObject = {}"
        - "infoObject.domainName = infoLines[0].split(\":\")[1].trim"
        - "infoObject.administrativeContact = infoLines[1].split(\":\")[1].trim"
        - "infoObject.emailAddress = infoLines[2].split(\":\")[1].trim"
        - "infoObject.phone = infoLines[3].split(\":\")[1].trim"
        - "print(\"Phone number: \" + infoObject.phone)"
      isProtected: false
      returns:
        - string
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
    returnVariations:
      ok:
        - Address not found
        - "Error: the IP address must be public"
        - "Invalid IP address: ${ip}"
        - No Info available
        - "whois: Invalid arguments"
    tags:
      - function
      - general
    typeString: function
    variations:
      ok: []
  wifi_networks:
    argStrings:
      - - computer
      - - string
    id: wifi_networks
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - computer
        - default: ~
          label: net_device
          opt: false
          types:
            - string
      description: "Returns a `list` of visible Wi-Fi network descriptions. Unknown devices and invalid objects return `null`; device and disabled-card failures, including `\"wifi_networks: wifi card is disabled\"`, are returned as strings."
      example:
        - "computer = host_computer(get_shell(\"root\", \"test\"))"
        - "networks = wifi_networks(computer, \"wlan0\")"
        - "result = []"
        - for network in networks
        - "   parsedItem = network.split(\" \")"
        - "   item = {}"
        - "   item.BSSID = parsedItem[0]"
        - "   item.PWR = parsedItem[1]"
        - "   item.ESSID = parsedItem[2]"
        - "   result.push(item)"
        - end for
        - print(result)
      isProtected: false
      returns:
        - type: list
          valueType: string
        - "null"
        - string
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - list<string>
      - "null"
      - string
    returnVariations:
      ok:
        - "wifi_networks: wifi card is disabled"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  yield:
    argStrings: []
    id: yield
    json:
      arguments: []
      description: Waits for the next tick.
      example:
        - while (true)
        - "   yield"
        - "   print(\"tick\")"
        - end while
      isProtected: false
      returns:
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - "null"
    returnVariations:
      ok: []
    tags:
      - function
      - general
    typeString: function
    variations:
      ok: []
