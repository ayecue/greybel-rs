  overflow:
    argStrings:
      - - metaLib
      - - string
      - - string
      - - string
    id: overflow
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - metaLib
        - default: ~
          label: memAddress
          opt: false
          types:
            - string
        - default: ~
          label: unsecValue
          opt: false
          types:
            - string
        - default:
            type: string
            value: ""
          label: args
          opt: false
          types:
            - string
      description: "Exploits a library vulnerability and returns the exploit result. Invalid argument types return `\"overflow: Invalid arguments\"`. For remote router exploits, firewall status is checked when the attack runs: `\"Connection refused. Address unreachable\"` or `\"Connection refused. The target is behind a firewall.\"` is printed and the method returns `null`. Other failed requirements also return `null`; disabled networks return an error `string`."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "metaLib = load(metax, \"/lib/init.so\")"
        - "scanResult = scan(metax, metaLib)"
        - "target = scanResult[0]"
        - "scanAddress = scan_address(metax, metaLib, target)"
        - "segments = split(scanAddress, \"Unsafe check: \")"
        - exploit = null
        - " for segment in segments"
        - "   hasRequirement = indexOf(segment, \"*\") != null"
        - "   if (not hasRequirement) then"
        - "      labelStart = indexOf(segment, \"<b>\")"
        - "      labelEnd = indexOf(segment, \"</b>\")"
        - "      exploit = segment[labelStart + 3: labelEnd]"
        - "   end if"
        - end for
        - if (exploit) then
        - "   print(\"Exploiting... \" + target + \":\" + exploit)"
        - "   print(overflow(metaLib, target, exploit))"
        - else
        - "   print(\"No exploit found with zero requirements\")"
        - end if
      isProtected: false
      returns:
        - string
        - number
        - shell
        - computer
        - file
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - shell
      - computer
      - file
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
        - "Exploit failed: the remote server has been temporarily disabled due to non-payment"
        - "overflow: Invalid arguments"
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  override_settings:
    argStrings:
      - - smartAppliance
      - - number
      - - number
    id: override_settings
    json:
      arguments:
        - default: ~
          label: self
