      - general
    typeString: function
    variations:
      ok: []
  bitAnd:
    argStrings:
      - - number
      - - number
    id: bitAnd
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: i
          opt: false
          types:
            - number
        - default:
            type: number
            value: 0
          label: j
          opt: false
          types:
            - number
      description: "Performs a bitwise AND for the provided values. Returns a `number`. Warning: If either operand is >= `0x80000000`, it'll always return 0."
      example:
        - "print(\"Result of bitwise AND: \" + bitAnd(1, 2))"
      isProtected: false
      returns:
        - number
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
