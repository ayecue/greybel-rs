    id: read
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - metaMail
        - default: ~
          label: mailIDs
          opt: false
          types:
            - type: list
              valueType: string
      description: "Takes a `list` of mail ID strings and returns a `list` of full-message strings in the same order, using `\"Mail not found\"` for each missing ID. A non-list argument or non-string element returns `null`. The account is refreshed first; refresh failures return `\"MetaMail: Unable to refresh mail account.\"`. Every mail method enforces a two-second cooldown after the previous mail use and returns `\"MetaMail: Wait 2 seconds before using mail again.\"` when called too soon."
      example:
        - "metaMail = mail_login(user_mail_address, \"test\")"
        - mails = fetch(metaMail)
        - "results = []"
        - for mail in mails
        - "   segments = split(mail, char(10))"
        - "   mailId = segments[2][8:]"
        - "   print(read(metaMail, mailId))"
        - end for
      isProtected: false
      returns:
        - type: list
          valueType: string
        - string
        - "null"
      type: function
