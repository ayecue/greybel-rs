      description: "Launches a process on the victim's `computer`, silently attempting to continuously connect in the background to the specified address and port. For the reverse shell to run successfully, the `rshell` service must be installed, and the port forward must be configured correctly on the machine where the server is waiting for the victim's connection. If the launch was successful, a `number` with the value one will be returned. In case of failure, a `string` with details will be returned."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - "rshell_client(metax, \"12.12.12.12\", 1222, \"bgprocess\")"
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 1
        - "connection rejected: port forward removed by admin"
        - "Error: ${programName} is a reserved process name"
        - "Error: only alphanumeric allowed as proccess name."
        - "Error: proccess name cannot exceed the limit of 28 characters."
        - Invalid target service port configuration.
        - No internet access.
        - Remote host is down
        - "rshell_client: connection refused. The server has reached its limit of 16 connections."
        - "rshell_client: Invalid IP address"
        - "rshell_client: IP address not found: ${ip}"
        - "rshell_client: unable to find remote server at port ${port}"
        - "Unable to connect: invalid ${library}"
        - "Unable to connect: missing ${library}"
        - "Unable to find service ${service}"
        - "Unexpected library found. Not a valid ${library} library."
        - Unknown error
    tags:
      - function
      - detached
    typeString: function
    variations:
      ok: []
  rshell_remove:
    argStrings:
      - - metaxploit
      - - list<shell>
        - "null"
    id: rshell_remove
    json:
      arguments:
        - default: ~
          label: self
          opt: false
          types:
            - metaxploit
        - default: ~
          label: shells
          opt: true
          types:
            - type: list
              valueType: shell
            - "null"
      description: "Removes reverse shells connected to the `metaxploit` computer's `rshell` service. With no shells argument or `null`, removes every shell on the forwarded service port; with a `list` of reverse `shell` objects, removes only matching connections. Returns `1` when at least one connection was removed and `0` otherwise."
      example:
        - "metax = include_lib(\"/lib/metaxploit.so\")"
        - shells = rshell_server(metax)
        - "removed = rshell_remove(metax, shells)"
        - print(removed)
      isProtected: false
      returns:
        - string
        - number
        - "null"
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - string
      - number
      - "null"
    returnVariations:
      ok:
        - 0
        - 1
        - "error: rshell portforward is not configured correctly"
        - "error: service rshelld is not running"
        - "rshell_remove: expected a list of reverse shells or null"
        - "rshell_remove: list must contain only reverse shells"
        - "rshell_remove: No internet connection"
        - "rshell_remove: The service cannot be started on this network."
    tags:
      - function
      - detached
      - ssh incompatible
    typeString: function
    variations:
      ok: []
  rshell_server:
