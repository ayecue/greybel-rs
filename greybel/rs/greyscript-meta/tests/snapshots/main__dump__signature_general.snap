      - general
    typeString: function
    variations:
      ok: []
  atan:
    argStrings:
      - - number
      - - number
    id: atan
    json:
      arguments:
        - default:
            type: number
            value: 0
          label: y
          opt: false
          types:
            - number
        - default:
            type: number
            value: 1
          label: x
          opt: false
          types:
            - number
      description: "Returns the inverse tangent (in radians) of a `number`."
      example:
        - opposite = 8
        - hypotenuse = 10
        - calcAngle = atan(opposite / hypotenuse)
        - "print(\"Angle: \" + calcAngle)"
      isProtected: false
      returns:
        - number
      type: function
    origin: general
    otherLanguageDescription: ~
    returnStrings:
      - number
    returnVariations:
      ok: []
    tags:
