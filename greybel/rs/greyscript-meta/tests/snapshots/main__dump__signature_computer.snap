---
source: greyscript-meta/tests/dump.rs
expression: part
---
definitionOrder:
  - get_ports
  - get_name
  - local_ip
  - public_ip
  - File
  - create_folder
  - is_network_active
  - touch
  - show_procs
  - network_devices
  - change_password
  - create_user
  - delete_user
  - create_group
  - delete_group
  - groups
