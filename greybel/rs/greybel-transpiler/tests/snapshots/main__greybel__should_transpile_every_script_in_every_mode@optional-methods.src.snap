Counter = {
          "n": 1,
          "cb": null,
}
Counter.add = function(x)
          self.n += x
          return self.n
end function
Counter.run = function
          return [
                    self.add?.(1),
                    self.cb?.(1),
          ]
end function
c = new Counter
double = function(x)
          return x * 2
end function
handlers = { "double": @double }
k = "double"
print([
          c.add?.(1),
          c.cb?.(1),
          c.n,
