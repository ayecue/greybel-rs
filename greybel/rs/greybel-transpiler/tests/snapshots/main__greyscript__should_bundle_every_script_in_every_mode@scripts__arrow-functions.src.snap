=== beautify
double = function(x)
	return x * 2
end function
items = [ { "name": "a" } ]
names = items.map(function(x))
	return x.name
end function
handler = function(line, sep = " ")
	parts = line.split(sep)
	return parts[0]
end function
print double(2) + handler("a b").len
f = function(g, n)
	return g(n)
end function
print f(function(v), 2)
	return v + 1
end function
