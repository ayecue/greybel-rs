EXPORTED = {}
__REQUIRE_EVAL = function(cb, ns)
	if EXPORTED.hasIndex(ns) then return EXPORTED[ns]
	result = cb(ns)
	if result == null then result = { "exports": null }
	if not result.hasIndex("exports") then result.exports = null
