=== default
a=[1]
d={"x":1}
name="n"
print(([]+a+[2]+a))
print(({}+d+{"y":2,"name":name}))
print(([]+a).len)
print(([]+(a or [])+[3]))
print({"name":name})
=== uglify
globals.I=globals
J=[1]
K={"x":1}
name="n"
print(([]+J+[2]+J))
print(({}+K+{"y":2,"name":name}))
print(([]+J).len)
print(([]+(J or [])+[3]))
print({"name":name})
=== beautify
a = [ 1 ]
d = { "x": 1 }
name = "n"
print ([] + a + [2] + a)
print ({} + d + {"y": 2, "name": name})
print ([] + a).len
print ([] + (a or []) + [3])
print { "name": name }
=== beautify, dev mode
a = [ 1 ]
d = { "x": 1 }
name = "n"
print [
	...a,
	2,
	...a,
]
print {
	...d,
	"y": 2,
	name,
}
print [ ...a ].len
print [
	...a or [],
	3,
]
print { name }
