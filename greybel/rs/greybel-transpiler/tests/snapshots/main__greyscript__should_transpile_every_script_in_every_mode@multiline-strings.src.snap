=== beautify
__MSTR = function(lines)
	return lines.join(char(10))
end function
// Grey Hack ends a string at a line break, so a string with line breaks becomes a call of __MSTR with its lines.
banner = __MSTR(["first line", "second line"])
print __MSTR(["trailing", ""])
print __MSTR(["", "leading"])
print __MSTR(["a", "", "b"]).len
print __MSTR(["say ""hi""", "ok"])
repeated = [
	__MSTR(["x", "y"]),
	__MSTR(["x", "y"]),
	__MSTR(["x", "y"]),
	__MSTR(["x", "y"]),
]
print "single line"
