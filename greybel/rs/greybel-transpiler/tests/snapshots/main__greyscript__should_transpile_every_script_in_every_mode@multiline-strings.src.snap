=== beautify
// Grey Hack ends a string at a line break, so a string with line breaks becomes a call of __MSTR with its lines.
banner = "first line¶second line".replace("¶", char(10))
print "trailing¶".replace("¶", char(10))
print "¶leading".replace("¶", char(10))
print "a¶¶b".replace("¶", char(10)).len
print "say ""hi""¶ok".replace("¶", char(10))
repeated = [
	"x¶y".replace("¶", char(10)),
	"x¶y".replace("¶", char(10)),
	"x¶y".replace("¶", char(10)),
	"x¶y".replace("¶", char(10)),
]
print "single line"
crlf = "a¶b".replace("¶", char(10))
