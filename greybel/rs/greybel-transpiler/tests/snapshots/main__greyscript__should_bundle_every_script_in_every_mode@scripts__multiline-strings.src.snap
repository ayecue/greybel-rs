=== beautify
__NL = char(10)
// Grey Hack ends a string at a line break, so a string with line breaks becomes a call of __MSTR with its lines.
banner = "first line" + __NL + "second line"
print "trailing" + __NL
print __NL + "leading"
print ("a" + __NL + __NL + "b").len
print "say ""hi""" + __NL + "ok"
repeated = [
	"x" + __NL + "y",
	"x" + __NL + "y",
	"x" + __NL + "y",
	"x" + __NL + "y",
]
print "single line"
crlf = "a" + __NL + "b"
