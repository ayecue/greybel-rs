Animal = {}
Animal.sound = "..."
Animal.count = 0
Animal.constructor = function(name, age = 3)
	self.tags = [ 0 ]
	self.name = name
	self.age = age
	Animal.count += 1
	return self
end function
Animal.speak = function
	return self.name + ":" + self.sound
end function
Animal.create = function(name, age = 3)
	return (new self).constructor(@name, @age)
end function
Dog = new Animal
Dog.sound = "woof"
Puppy = new Dog
Puppy.sound = "yip"
