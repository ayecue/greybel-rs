c = 1
a = c ? "yes" : "no"
b = null ?? "default"
user = {"name": {"first": "Ada"}}
n = user?.name.first
none = null
m = none?.[0]
callback = function(x, y)
	return x + y
end function
r = callback?.(1, 2)
print(c ? (a ?? 1) : 3)
k = {"a": c ? 1 : 2}
if c then print(none ?? "fallback")
f = function(v)
	return v ? "set" : "unset"
end function
none?.run
x = null
while (x ?? 0) < 2
	x = (x ?? 0) + 1
end while
if not c then
	print(1)
else if (x ?? 0) > 1 then
	print("else if")
end if
print([a, b, n, m, r, k, f(0)].join(","))
