    variations:
      ok: []
  remove:
    argStrings:
      - - string
    id: remove
    json:
      arguments:
        - default: ~
          label: toDelete
          opt: false
          types:
            - string
      description: "Returns a new `string` where the provided `string` got removed."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "newString = myString.remove(\"wrong\")"
        - "print(newString + \"right\")"
      isProtected: false
      returns:
        - string
      type: function
    origin: string
