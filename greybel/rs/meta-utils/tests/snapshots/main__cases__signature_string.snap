  val:
    argStrings: []
    id: val
    json:
      arguments: []
      description: "Returns a `number` which is parsed from the `string`. In case the `string` is not numeric it will return a zero."
      example:
        - "myString = \"1.25\""
        - print(myString.val + 40.75)
      isProtected: false
      returns:
