        - default: ~
          label: newString
          opt: false
          types:
            - string
      description: "Returns a new `string` where the provided `string` got replaced by the second provided `string`."
      example:
        - "myString = \"42 as an answer is wrong\""
        - "newString = myString.replace(\"wrong\", \"right\")"
        - print(newString)
      isProtected: false
      returns:
