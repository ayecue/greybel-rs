    typeString: function
    variations:
      ok: []
  indexes:
    argStrings: []
    id: indexes
    json:
      arguments: []
      description: "Returns a `list` where each item is a `number` representing all available indexes in the `string`."
      example:
        - "myString = \"42\""
        - print(myString.indexes)
      isProtected: false
      returns:
        - type: list
          valueType: number
      type: function
    origin: string
