      description: "Removes an item from the `list` with the provided index. Due to the removal the `list` will get mutated."
      example:
        - "myList = [1, 42, 3]"
        - myList.remove(1)
        - "print(\"This list does not contain the answer to everything: \" + myList.split(\", \"))"
      isProtected: false
