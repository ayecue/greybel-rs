          types:
            - any
        - default: ~
          label: newVal
          opt: false
          types:
            - T
        - default: ~
          label: maxCount
          opt: true
          types:
            - number
      description: "Returns updated `list` where each value matching with the provided replace argument gets replaced. This operation will mutate the `list`."
      example:
        - "myList = [1, 2, 2, 7]"
        - "myList.replace(2, 3)"
