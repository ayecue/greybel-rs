- input:
    content: "divideString = function(str,limit)\n\toffset = 0\n\tmaxLen = str.len\n\tfrags = []\n\n\twhile offset < maxLen\n\t\tnext = offset + limit\n\t\tfrags.push(str[offset:next])\n\t\toffset = next\n\tend while\n\n\treturn frags\nend function\n\nprint(divideString(\"blahhblahhblahhblahhblahhblahhgad\",5))\n\ntest.current_path = \"/home/\"+test.moo[-1].user[test.bar[-1].foo.indexOf(\"@\")+1:]\n\nfor i in range(0,s.len-4)\n\tif f.hasIndex(s[i:i+3]) then f[s[i:i+3]][s.len]=1 else f[s[i:i+3]]={s.len:1}\nend for\n\nfoo[1:]\nfoo[:1]\nfoo[foo[1:]:]\nfoo[:foo[:1]]\nfoo[foo[1:]:foo[:1]]"
    env: ~
    filename: ~
    kind: parser
    preserve: false
